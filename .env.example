# ID de tu formulario de Formspree (plan gratis). Lo encuentras en la URL del endpoint
# que te da Formspree: https://formspree.io/f/TU_ID_AQUI
PUBLIC_FORMSPREE_ID=

# Measurement ID de tu propiedad GA4 (lo creas en https://analytics.google.com → Admin →
# Data Streams → tu stream web). Formato G-XXXXXXXXXX. Mientras no esté seteado, el sitio
# no carga ni ofrece Google Analytics (ver CookieConsent.astro / BaseLayout.astro).
PUBLIC_GA_MEASUREMENT_ID=
