---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CaseHero from '../components/case/CaseHero.astro';
import CaseCover from '../components/case/CaseCover.astro';
import CaseGallery from '../components/case/CaseGallery.astro';
import CaseShowcase from '../components/case/CaseShowcase.astro';
import MetricsStrip from '../components/case/MetricsStrip.astro';
import CaseBody from '../components/case/CaseBody.astro';
import CaseNextLink from '../components/case/CaseNextLink.astro';
import type { Lang, UiDictionary } from '../i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'cases-es' | 'cases-en'>;
  t: UiDictionary;
  esHref: string;
  enHref: string;
  nextHref: string;
}

const { lang, entry, t, esHref, enHref, nextHref } = Astro.props;
const d = entry.data;
const backHref = `/${lang}/#trabajo`;

// <title> ≤ 60 y meta description ≤ 155 caracteres, para que Google no los corte en los resultados.
const clip = (s: string, n: number) => {
  if (s.length <= n) return s;
  const cut = s.slice(0, n - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[,.;:\-—\s]+$/, '') + '…';
};
const shortTitle = d.seoTitle ?? d.title;
const pagePath = lang === 'es' ? esHref : enHref;
---

<BaseLayout
  lang={lang}
  title={`${shortTitle} | Pablo Kohler`}
  description={clip(d.lead, 155)}
  breadcrumb={[{ name: shortTitle, url: pagePath }]}
  navDict={t.nav}
  cookieDict={t.cookieConsent}
  esHref={esHref}
  enHref={enHref}
  back={{ href: backHref, label: t.caseDetail.back }}
>
  <CaseHero title={d.title} lead={d.lead} tags={d.tags} liveUrl={d.liveUrl} liveLabel={d.showcase?.liveLabel} />
  {
    d.showcase ? (
      <CaseShowcase data={d.showcase} liveUrl={d.liveUrl} />
    ) : (
      <>
        <CaseCover coverNote={t.caseDetail.coverNote} coverImage={d.coverImage} fit={d.coverFit} />
        {d.gallery && <CaseGallery label={t.caseDetail.gallery} images={d.gallery} layout={d.galleryLayout} />}
      </>
    )
  }
  <MetricsStrip metrics={d.metrics} metricLabel={t.caseDetail.metricLabel} />
  <CaseBody
    meta={{ client: d.client, year: d.year, role: d.role, scope: d.scope }}
    metaLabels={t.caseDetail}
    sections={[d.sections.context, d.sections.work, d.sections.result]}
  />
  <CaseNextLink href={nextHref} label={d.nextCaseTitle} nextCaseLabel={t.caseDetail.nextCase} />
</BaseLayout>
