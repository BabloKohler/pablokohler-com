---
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import CookieConsent from '../components/CookieConsent.astro';
import portrait from '../assets/about/pablo-kohler.jpg';
import type { Lang, UiDictionary } from '../i18n';
import { IS_AU, MAIN_URL, AU_URL, isSharedEnPath } from '../site-target';
// Fuentes autoalojadas (antes: Google Fonts, que bloqueaba el render y retrasaba FCP/LCP ~2 s en móvil).
import '@fontsource-variable/archivo';
import '@fontsource-variable/public-sans';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import publicSansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import { STAR_PATH, STAR_VIEWBOX } from '../components/star-path';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  navDict: UiDictionary['nav'];
  cookieDict: UiDictionary['cookieConsent'];
  /** Rutas absolutas de esta misma página en cada idioma, para hreflang + el switch de idioma. */
  esHref: string;
  enHref: string;
  back?: { href: string; label: string };
  /** Páginas privadas de cliente: sin la barra de navegación del sitio. */
  hideNav?: boolean;
  /** Páginas sin contenido aún (p. ej. blog vacío): no se indexan. */
  noindex?: boolean;
  /** Migas de pan después de "Inicio" (para el JSON-LD BreadcrumbList). */
  breadcrumb?: { name: string; url: string }[];
}

const { lang, title, description, navDict, cookieDict, back, noindex, breadcrumb, hideNav } = Astro.props;

// Todas las URLs terminan en "/" (así coinciden el sitemap, los enlaces internos y el canonical).
const slash = (p: string) => (p.endsWith('/') || p.includes('#') || p.includes('?') ? p : `${p}/`);
const esHref = slash(Astro.props.esHref);
const enHref = slash(Astro.props.enHref);
const otherLangHref = lang === 'es' ? enHref : esHref;
const canonicalHref = new URL(lang === 'es' ? esHref : enHref, Astro.site);

// hreflang: en .com ES + EN (+ en-AU cruzado en las páginas compartidas); en .com.au en-AU (+ es/en cruzados
// en las páginas compartidas, para que el grupo sea recíproco en los tres sitios).
const shared = isSharedEnPath(enHref);
const alternates: { hl: string; href: URL }[] = IS_AU
  ? [
      { hl: 'en-AU', href: new URL(enHref, AU_URL) },
      ...(shared
        ? [
            { hl: 'en', href: new URL(enHref, MAIN_URL) },
            { hl: 'es', href: new URL(esHref, MAIN_URL) },
          ]
        : []),
      { hl: 'x-default', href: shared ? new URL(esHref, MAIN_URL) : new URL(enHref, AU_URL) },
    ]
  : [
      { hl: 'es', href: new URL(esHref, MAIN_URL) },
      { hl: 'en', href: new URL(enHref, MAIN_URL) },
      ...(shared ? [{ hl: 'en-AU', href: new URL(enHref, AU_URL) }] : []),
      { hl: 'x-default', href: new URL(esHref, MAIN_URL) },
    ];
const htmlLang = lang === 'es' ? 'es' : IS_AU ? 'en-AU' : 'en';
const ogLocale = lang === 'es' ? 'es_CL' : IS_AU ? 'en_AU' : 'en_US';
const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_CL';

// Misma foto que "Sobre mí", reescalada para vista previa en redes (og:image / Twitter card).
const ogImage = await getImage({ src: portrait, width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);

// Datos estructurados: quién soy (para búsquedas de mi nombre) + el servicio y sus mercados
// (Chile, Latinoamérica y Australia — hacia donde me estoy relocalizando).
const jobTitle =
  lang === 'es' ? 'Consultor de marketing digital y comunicaciones' : 'Digital marketing & communications consultant';
const serviceDescription =
  lang === 'es'
    ? 'Estrategia digital y construcción técnica —sitios web, SEO y automatización— para clientes en Chile, Latinoamérica y Australia.'
    : 'Digital strategy and technical execution — websites, SEO, and automation — for clients across Latin America and Australia.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${Astro.site}#pablo-kohler`,
      name: 'Pablo Kohler',
      url: String(Astro.site),
      image: String(ogImageUrl),
      jobTitle,
      sameAs: ['https://www.linkedin.com/in/pablo-kohler/'],
    },
    {
      '@type': 'Service',
      serviceType: jobTitle,
      description: serviceDescription,
      provider: { '@id': `${Astro.site}#pablo-kohler` },
      areaServed: [
        { '@type': 'Country', name: 'Chile' },
        { '@type': 'Place', name: 'Latin America' },
        { '@type': 'Country', name: 'Australia' },
      ],
    },
  ],
};

// Build AU: negocio de servicio local en Sydney (sin dirección pública) y sin mencionar Chile.
// `url` y el @id usan Astro.site, que en AU es https://pablokohler.com.au.
const auJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${Astro.site}#pablo-kohler`,
      name: 'Pablo Kohler',
      url: String(Astro.site),
      image: String(ogImageUrl),
      jobTitle: 'Web designer and digital marketing consultant',
      knowsLanguage: ['en', 'es'],
      sameAs: ['https://www.linkedin.com/in/pablo-kohler/'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${Astro.site}#business`,
      name: 'Pablo Kohler',
      url: String(Astro.site),
      image: String(ogImageUrl),
      description:
        'Website redesign, new websites, website care plans and virtual assistant services for small businesses in Sydney and across Australia.',
      founder: { '@id': `${Astro.site}#pablo-kohler` },
      areaServed: [
        { '@type': 'City', name: 'Sydney' },
        { '@type': 'AdministrativeArea', name: 'New South Wales' },
        { '@type': 'Country', name: 'Australia' },
      ],
      address: { '@type': 'PostalAddress', addressLocality: 'Sydney', addressRegion: 'NSW', addressCountry: 'AU' },
      makesOffer: [
        'Website redesign',
        'Website care plans',
        'Free website audit',
        'New website design',
        'Virtual assistant services',
      ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
    },
  ],
};
const baseGraph = (IS_AU ? auJsonLd : jsonLd)['@graph'];

// Migas de pan (Inicio → página): ayuda a Google a entender la jerarquía y las muestra en los resultados.
const crumbs = breadcrumb ? [{ name: lang === 'es' ? 'Inicio' : 'Home', url: `/${lang}/` }, ...breadcrumb] : null;
const breadcrumbNode = crumbs
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.url, Astro.site).href,
      })),
    }
  : null;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [...baseGraph, ...(breadcrumbNode ? [breadcrumbNode] : [])],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hl} href={a.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pablo Kohler" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    {!IS_AU && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={publicSansLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- Estrella firma: una sola definición por página, reutilizada con <use href="#slp-star"> (Star, hero, footer) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs><symbol id="slp-star" viewBox={STAR_VIEWBOX}><path d={STAR_PATH}></path></symbol></defs></svg>
    <div class="grain"></div>
    {!hideNav && <Nav lang={lang} t={navDict} otherLangHref={otherLangHref} back={back} showLangSwitch={!IS_AU} />}
    <slot />
    <CookieConsent lang={lang} t={cookieDict} />

    <script>
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.btn-primary');
        if (!btn) return;
        btn.classList.remove('pop');
        // Fuerza un reflow para poder reiniciar la animación si se hace clic varias veces seguidas.
        void (btn as HTMLElement).offsetWidth;
        btn.classList.add('pop');
        setTimeout(() => btn.classList.remove('pop'), 320);
      });

      // El sol siempre se asoma centrado por abajo, con un color cálido distinto cada vez
      // que el mouse entra al botón (nunca repite el de la vez anterior). Al salir del
      // hover retrocede por el mismo camino y queda oculto bajo el botón.
      const WARM_COLORS = ['var(--coral)', 'var(--amber)', 'var(--magenta)'];
      let lastSunColor = '';
      document.querySelectorAll<HTMLElement>('.btn-primary').forEach((btn) => {
        btn.addEventListener('mouseenter', () => {
          const colorOptions = WARM_COLORS.filter((c) => c !== lastSunColor);
          const nextColor = colorOptions[Math.floor(Math.random() * colorOptions.length)];
          lastSunColor = nextColor;
          btn.style.setProperty('--sun-color', nextColor);
        });
      });

      // Revelado en scroll: un solo observer global para cualquier [data-reveal] de la
      // página (secciones, tarjetas, beats de Capacidades). Se agrega .is-visible una vez
      // y se deja de observar — no repite la animación si el usuario vuelve a scrollear.
      const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (revealTargets.length) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) {
          revealTargets.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
          );
          revealTargets.forEach((el) => io.observe(el));
        }
      }
    </script>
  </body>
</html>
