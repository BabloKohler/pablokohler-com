---
import { Image } from 'astro:assets';
import Star from '../Star.astro';
import portrait from '../../assets/about/pablo-kohler.jpg';
import shotShe from '../../assets/eric/shelovespink.jpg';
import shotBondi from '../../assets/eric/bondipainters.jpg';
import shotHeritage from '../../assets/eric/heritagepainting.jpg';
import shotIndustrial from '../../assets/eric/industrialpainters.jpg';

const calendly = 'https://calendly.com/pablokohlerlara/30min';

// Cuando Eric responde "Sounds good", el formulario del sitio (Formspree) avisa a Pablo por correo.
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const notifyUrl = formspreeId ? `https://formspree.io/f/${formspreeId}` : undefined;

const sites = [
  { name: 'She Loves Pink', url: 'shelovespink.com.au', img: shotShe },
  { name: 'Bondi Painters', url: 'bondipainters.com.au', img: shotBondi },
  { name: 'Heritage Painting', url: 'heritagepaintingservices.com.au', img: shotHeritage },
  { name: 'Industrial Painters', url: 'industrialpainters.com.au', img: shotIndustrial },
];

const steps = [
  {
    title: 'You send me the material',
    desc: 'Images, logos, texts, comments, everything you have for that site.',
  },
  {
    title: 'I put it all together',
    desc: 'I build the site. It is basically what we did when we worked side by side.',
  },
  {
    title: 'We make the changes it needs',
    desc: 'Once it is built, we make all the changes that are necessary.',
  },
  {
    title: 'Analytics and Search Console',
    desc: 'I install Google Analytics and Google Search Console, so you can see how the site is doing.',
  },
  {
    title: 'We polish it, and it is done',
    desc: 'A last round of polish, and the site is finished and live.',
  },
];

const included = [
  'Your material turned into a finished website',
  'All the changes it needs along the way',
  'Google Analytics and Google Search Console installed',
  'A final polish before it goes live',
];

const products = [
  { name: 'Graphic design', price: 'from A$50', desc: 'Logos, flyers, social media posts and more.' },
  { name: 'Google Ads', price: 'A$200 per campaign', desc: 'A search campaign, set up and ready to run. The ad budget itself is separate.' },
  { name: 'Editorial design', desc: 'Brochures, proposals and other printed material.' },
  { name: 'Apps', desc: 'Quote calculators, booking forms and small tools made for the way you work.' },
  { name: 'Analytics', desc: 'See which of your sites bring in calls and enquiries.' },
  { name: 'Meta Ads', desc: 'Facebook and Instagram campaigns, set up and managed.' },
];

const scenes = [
  { id: 'hello', label: 'Hello' },
  { id: 'idea', label: 'The idea' },
  { id: 'how', label: 'How it works' },
  { id: 'price', label: 'The price' },
  { id: 'more', label: 'And more' },
  { id: 'reply', label: 'Your reply' },
];

const img = { src: portrait, width: 96, height: 96, format: 'webp' as const, quality: 80, alt: 'Pablo' };
---

<script is:inline>
  document.documentElement.classList.add('js');
</script>

<div class="convo">
  <div class="progress" aria-hidden="true"><span></span></div>

  <nav class="rail" aria-label="Sections">
    {scenes.map((s) => <a href={`#${s.id}`} data-rail={s.id} aria-label={s.label}><span>{s.label}</span></a>)}
  </nav>

  <section class="scene scene--hero" id="hello">
    <div class="wrap">
      <div class="group" data-group>
        <Image {...img} class="avatar" />
        <div class="stack">
          <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="msg msg--big">Hi Eric.</p>
          <p class="msg">This is to go deeper into something we have already talked about.</p>
        </div>
      </div>
      <a href="#idea" class="hint" aria-label="Scroll down"><span>Scroll down</span><i aria-hidden="true"></i></a>
    </div>
  </section>

  <section class="scene" id="idea">
    <div class="wrap">
      <div class="group" data-group>
        <Image {...img} class="avatar" />
        <div class="stack">
          <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="msg">We have already worked together quite a lot.</p>
        </div>
      </div>

      <div class="shots" data-shots>
        <div class="browser">
          <div class="browser-bar">
            <span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="browser-url" data-url>{sites[0].url}</span>
            <a class="browser-visit" data-visit href={`https://${sites[0].url}`} target="_blank" rel="noopener">Visit site</a>
          </div>
          <div class="browser-screen">
            {
              sites.map((st, i) => (
                <Image
                  src={st.img}
                  width={1100}
                  format="webp"
                  quality={82}
                  alt={`${st.name} website`}
                  class={`shot${i === 0 ? ' is-active' : ''}`}
                  data-shot
                />
              ))
            }
          </div>
        </div>
        <div class="shot-tabs" role="group" aria-label="Sites">
          {
            sites.map((st, i) => (
              <button type="button" class={`shot-tab${i === 0 ? ' is-active' : ''}`} data-tab={i} data-site={st.url} aria-pressed={i === 0 ? 'true' : 'false'}>
                {st.name}
              </button>
            ))
          }
        </div>
        <p class="shots-note">A few of the sites I have built.</p>
      </div>

      <div class="group group--cont" data-group>
        <Image {...img} class="avatar" />
        <div class="stack">
          <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="msg">So I would like to try a new way of working: pay per delivered product.</p>
          <p class="msg">In other words:</p>
          <p class="msg msg--hl">a finished website, ready and live.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="scene scene--tall" id="how">
    <div class="wrap">
      <div class="group" data-group>
        <Image {...img} class="avatar" />
        <div class="stack">
          <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="msg msg--big">So how would we do it?</p>
        </div>
      </div>

      <ol class="timeline" data-timeline>
        {
          steps.map((st, i) => (
            <>
              <li class="tl-step" data-step>
                <span class="tl-dot" aria-hidden="true">{i + 1}</span>
                <div class="tl-body">
                  <h3>{st.title}</h3>
                  <p>{st.desc}</p>
                </div>
              </li>
              {i === 1 && (
                <li class="tl-step tl-step--note" data-step>
                  <span class="tl-dot" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
                  </span>
                  <div class="tl-body">
                    <h3>In between: a meeting or a call</h3>
                    <p>
                      We can book a meeting or a call and work on the site at the same time.
                      <a href={calendly} class="tl-link" target="_blank" rel="noopener" data-track="booking_click" data-track-location="eric_timeline">Pick a time</a>
                    </p>
                  </div>
                </li>
              )}
            </>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="scene" id="price">
    <div class="wrap">
      <div class="group" data-group>
        <Image {...img} class="avatar" />
        <div class="stack">
          <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="msg">And that is everything. For all of it, the price I am offering is only for you:</p>
        </div>
      </div>

      <div class="price-card" data-price>
        <div class="price-star" aria-hidden="true">
          <Star size="clamp(64px, 9vw, 110px)" color="var(--coral)" spin duration={108} />
        </div>
        <p class="price-tag">Only for you, Eric</p>
        <p class="price-num"><span class="accent">A$<span data-count="800">800</span></span></p>
        <p class="price-unit">per site, delivered and live</p>
        <p class="price-why">
          That is roughly two days of work, and it is still below the market price of a website.
        </p>
        <ul class="check" data-check>
          {
            included.map((t) => (
              <li>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg>
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
        <p class="price-note">Hosting and domains stay with you, as they are today.</p>
      </div>

      <div class="calc" data-calc>
        <p class="calc-label">Want to see the maths? How many sites?</p>
        <div class="calc-row">
          <button type="button" class="calc-btn" data-dec aria-label="One fewer site">&minus;</button>
          <output class="calc-n" data-n aria-live="polite">1</output>
          <button type="button" class="calc-btn" data-inc aria-label="One more site">+</button>
          <span class="calc-total">= <strong data-total>A$800</strong></span>
        </div>
      </div>
    </div>
  </section>

  <section class="scene" id="more">
    <div class="wrap">
      <div class="group" data-group>
        <Image {...img} class="avatar" />
        <div class="stack">
          <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="msg">I can also take on specific products, one at a time. Here is some of what I can do:</p>
        </div>
      </div>
      <ul class="products" data-chips>
        {
          products.map((p) => (
            <li class:list={['prod', { 'prod--priced': p.price }]}>
              <div class="prod-top">
                <h3>{p.name}</h3>
                <span class="prod-price">{p.price ?? 'Quoted per project'}</span>
              </div>
              <p>{p.desc}</p>
            </li>
          ))
        }
      </ul>
      <p class="chips-note">All prices in Australian dollars. These are separate from the price of a site, and only if you want them.</p>
    </div>
  </section>

  <section class="scene scene--last" id="reply">
    <div class="wrap">
      <div class="group" data-group>
        <Image {...img} class="avatar" />
        <div class="stack">
          <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="msg msg--big">So, Eric, what do you think?</p>
        </div>
      </div>

      <div class="replies" data-replies data-notify={notifyUrl}>
        <button type="button" class="reply-btn" data-reply="yes">Sounds good</button>
        <button type="button" class="reply-btn" data-reply="question">I have a question</button>
      </div>

      <div class="thread" aria-live="polite">
        <div class="thread-block" data-block="yes" hidden>
          <p class="eric">Sounds good</p>
          <div class="group" data-group>
            <Image {...img} class="avatar" />
            <div class="stack">
              <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
              <p class="msg">Great. I will get in touch with you soon to pick the first site and set a start date.</p>
              <p class="msg">If you would rather choose a time yourself:</p>
              <div class="msg msg--cta">
                <a href={calendly} class="btn btn-primary" target="_blank" rel="noopener" data-track="booking_click" data-track-location="eric_yes">
                  <Star class="btn-sun" size="77px" color="var(--sun-color, var(--coral))" />
                  <span class="btn-label">Pick a time that suits you</span>
                </a>
              </div>
            </div>
          </div>
        </div>
        <div class="thread-block" data-block="question" hidden>
          <p class="eric">I have a question</p>
          <div class="group" data-group>
            <Image {...img} class="avatar" />
            <div class="stack">
              <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
              <p class="msg">Of course. Let us talk it through.</p>
              <div class="msg msg--cta">
                <a href={calendly} class="btn btn-primary" target="_blank" rel="noopener" data-track="booking_click" data-track-location="eric_question">
                  <Star class="btn-sun" size="77px" color="var(--sun-color, var(--coral))" />
                  <span class="btn-label">Pick a time that suits you</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="private">This page was prepared for Eric and is not meant to be shared. &copy; Pablo Kohler</p>
    </div>
  </section>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const clamp = (n: number, a: number, b: number) => Math.min(b, Math.max(a, n));

  // Cada grupo de mensajes escribe un momento ("...") y luego aparece de a uno.
  const play = async (group: HTMLElement) => {
    if (group.dataset.played) return;
    group.dataset.played = '1';
    const items = [...group.querySelectorAll<HTMLElement>('.msg')];
    if (reduce) return items.forEach((i) => i.classList.add('is-in'));
    group.classList.add('is-typing');
    await wait(650);
    group.classList.remove('is-typing');
    for (const el of items) {
      el.classList.add('is-in');
      await wait(520);
    }
  };

  const watch = (els: Element[], cb: (el: HTMLElement) => void, threshold = 0.4) => {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            cb(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        }),
      { threshold, rootMargin: '0px 0px -8% 0px' },
    );
    els.forEach((el) => io.observe(el));
  };

  // Grupos visibles al cargar la página (los de las respuestas esperan al clic).
  watch(
    [...document.querySelectorAll<HTMLElement>('.convo > .scene [data-group]')].filter((g) => !g.closest('.thread-block')),
    play,
  );

  // Pasos: la línea se va llenando con el scroll y cada paso se enciende al llegar a ella.
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  const bar = document.querySelector<HTMLElement>('.progress span');
  const rail = [...document.querySelectorAll<HTMLElement>('[data-rail]')];
  const scenes = rail.map((a) => document.getElementById(a.dataset.rail as string) as HTMLElement);

  let ticking = false;
  const update = () => {
    ticking = false;
    const vh = window.innerHeight;
    const max = document.documentElement.scrollHeight - vh;
    if (bar) bar.style.transform = `scaleX(${max > 0 ? clamp(window.scrollY / max, 0, 1) : 0})`;

    if (timeline) {
      const r = timeline.getBoundingClientRect();
      const line = vh * 0.62;
      timeline.style.setProperty('--p', String(clamp((line - r.top) / r.height, 0, 1)));
      steps.forEach((s) => s.classList.toggle('on', s.getBoundingClientRect().top < line));
    }

    let active = 0;
    scenes.forEach((s, i) => {
      if (s.getBoundingClientRect().top < vh * 0.5) active = i;
    });
    rail.forEach((a, i) => a.classList.toggle('on', i === active));
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();

  // Precio: cuenta hasta 800 y va marcando lo que incluye.
  const num = document.querySelector<HTMLElement>('[data-count]');
  const card = document.querySelector<HTMLElement>('[data-price]');
  if (card) {
    watch(
      [card],
      () => {
        card.classList.add('is-in');
        if (num && !reduce) {
          const target = Number(num.dataset.count);
          const t0 = performance.now();
          const tick = (now: number) => {
            const k = clamp((now - t0) / 1100, 0, 1);
            num.textContent = String(Math.round(target * (1 - Math.pow(1 - k, 3))));
            if (k < 1) requestAnimationFrame(tick);
          };
          num.textContent = '0';
          requestAnimationFrame(tick);
        }
        const items = [...card.querySelectorAll<HTMLElement>('.check li')];
        items.forEach((li, i) => setTimeout(() => li.classList.add('is-in'), reduce ? 0 : 700 + i * 260));
      },
      0.35,
    );
  }

  // Calculadora: cuántos sitios, cuánto en total.
  const calc = document.querySelector<HTMLElement>('[data-calc]');
  if (calc) {
    const n = calc.querySelector<HTMLElement>('[data-n]') as HTMLElement;
    const total = calc.querySelector<HTMLElement>('[data-total]') as HTMLElement;
    let count = 1;
    const show = () => {
      n.textContent = String(count);
      total.textContent = 'A$' + (count * 800).toLocaleString('en-AU');
    };
    calc.querySelector('[data-dec]')?.addEventListener('click', () => {
      count = Math.max(1, count - 1);
      show();
    });
    calc.querySelector('[data-inc]')?.addEventListener('click', () => {
      count = Math.min(30, count + 1);
      show();
    });
  }

  // Galería de sitios: pestañas, cambio automático y pausa al interactuar.
  const shots = document.querySelector<HTMLElement>('[data-shots]');
  if (shots) {
    const imgs = [...shots.querySelectorAll<HTMLElement>('[data-shot]')];
    const tabs = [...shots.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const urlEl = shots.querySelector<HTMLElement>('[data-url]');
    const visit = shots.querySelector<HTMLAnchorElement>('[data-visit]');
    let cur = 0;
    let timer: number | undefined;
    const show = (i: number) => {
      cur = i;
      imgs.forEach((im, k) => im.classList.toggle('is-active', k === i));
      tabs.forEach((t, k) => {
        t.classList.toggle('is-active', k === i);
        t.setAttribute('aria-pressed', String(k === i));
      });
      const url = tabs[i].dataset.site as string;
      if (urlEl) urlEl.textContent = url;
      if (visit) visit.href = 'https://' + url;
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      if (reduce || timer || shots.dataset.manual) return;
      timer = window.setInterval(() => show((cur + 1) % imgs.length), 3800);
    };
    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        shots.dataset.manual = '1';
        stop();
        show(i);
      }),
    );
    shots.addEventListener('mouseenter', stop);
    shots.addEventListener('mouseleave', start);
    watch(
      [shots],
      () => {
        shots.classList.add('is-in');
        start();
      },
      0.3,
    );
  }

  // Extras: aparecen de a uno.
  const chips = document.querySelector<HTMLElement>('[data-chips]');
  if (chips) {
    // La lista es más alta que una pantalla de teléfono: umbral bajo y respaldo al hacer scroll.
    const revealChips = () => {
      if (chips.dataset.in) return;
      chips.dataset.in = '1';
      [...chips.children].forEach((c, i) => setTimeout(() => c.classList.add('is-in'), reduce ? 0 : i * 110));
    };
    watch([chips], revealChips, 0.12);
    window.addEventListener(
      'scroll',
      () => {
        if (chips.getBoundingClientRect().top < window.innerHeight * 0.8) revealChips();
      },
      { passive: true },
    );
  }

  // Aviso: cuando Eric responde "Sounds good", llega un correo a Pablo (Formspree).
  const notify = (url: string | undefined) => {
    if (!url) return;
    const fd = new FormData();
    fd.append('name', 'Eric (proposal page)');
    fd.append('_subject', 'Eric replied "Sounds good" on your proposal page');
    fd.append('message', 'Eric clicked "Sounds good" on the proposal page. Please get in touch with him.');
    fd.append('page', location.href);
    fd.append('sent_at', new Date().toISOString());
    fetch(url, { method: 'POST', body: fd, headers: { Accept: 'application/json' } }).catch(() => {});
  };

  // Respuesta: Eric elige y Pablo contesta.
  const replies = document.querySelector<HTMLElement>('[data-replies]');
  replies?.querySelectorAll<HTMLButtonElement>('[data-reply]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const choice = btn.dataset.reply as string;
      replies.querySelectorAll<HTMLButtonElement>('[data-reply]').forEach((b) => {
        b.disabled = true;
        b.classList.toggle('is-chosen', b === btn);
      });
      replies.classList.add('is-done');
      if (choice === 'yes') notify(replies.dataset.notify);
      const block = document.querySelector<HTMLElement>(`[data-block="${choice}"]`);
      if (!block) return;
      block.hidden = false;
      (window as unknown as { trackEvent?: (n: string, p?: object) => void }).trackEvent?.('eric_reply', { choice });
      const group = block.querySelector<HTMLElement>('[data-group]');
      if (group) setTimeout(() => play(group), 350);
      block.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    });
  });
</script>

<style>
  .convo {
    position: relative;
    color: var(--ink);
    font-family: var(--body);
  }

  /* Barra de avance y puntos laterales */
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 50;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: left;
  }
  .rail {
    position: fixed;
    right: clamp(14px, 2vw, 32px);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: none;
    flex-direction: column;
    gap: 14px;
  }
  @media (min-width: 1100px) {
    .rail {
      display: flex;
    }
  }
  .rail a {
    position: relative;
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: transparent;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }
  .rail a.on {
    background: var(--coral);
    border-color: var(--coral);
    transform: scale(1.25);
  }
  .rail a span {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink);
    background: var(--paper);
    padding: 3px 10px;
    border-radius: 100px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .rail a:hover span,
  .rail a:focus-visible span {
    opacity: 1;
  }

  /* Escenas */
  .scene {
    min-height: 92svh;
    display: flex;
    align-items: center;
    padding: clamp(72px, 12vh, 120px) clamp(20px, 5vw, 48px);
  }
  .scene--hero {
    min-height: 100svh;
  }
  .scene--tall {
    min-height: 0;
    align-items: flex-start;
  }
  .scene--last {
    min-height: 100svh;
  }
  .wrap {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 5vh, 44px);
  }

  /* Conversación */
  .group {
    display: flex;
