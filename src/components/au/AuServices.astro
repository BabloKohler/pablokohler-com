---
import { AU_SERVICES, type AuService } from '../../data/au-services';

interface Props {
  items?: AuService[];
  id?: string;
  headline?: string;
  accent?: string;
  intro?: string;
  location?: string;
  /** Ruta de cada tarjeta. Por defecto, la del .com.au (/en/<slug>/). */
  hrefOf?: (s: AuService) => string;
}
const {
  items = AU_SERVICES,
  id = 'au-services',
  headline = 'How I can help',
  accent = 'your business',
  intro = 'Websites that work, someone to look after them, and an extra pair of hands for the admin.',
  location = 'home',
  hrefOf = (s: AuService) => `/en/${s.slug}/`,
} = Astro.props;
---

<section class="au-services" id={id}>
  <div class="au-head reveal" data-reveal>
    <h2>{headline} <span class="accent">{accent}</span></h2>
    <p>{intro}</p>
  </div>
  <div class="au-grid">
    {
      items.map((s, i) => (
        <a
          href={hrefOf(s)}
          class="au-card reveal"
          data-reveal
          style={`transition-delay:${i * 0.06}s`}
          data-track="service_card_click"
          data-track-service={s.cardTitle}
          data-track-location={location}
        >
          <h3>{s.cardTitle}</h3>
          <p>{s.cardBlurb}</p>
          <span class="au-from">{s.cardFrom}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .au-services {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(60px, 9vh, 110px) clamp(24px, 5vw, 72px) 0;
  }
  .au-head {
    max-width: 640px;
    margin-bottom: 40px;
  }
  .au-head h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--fs-h2);
    letter-spacing: -0.03em;
    line-height: 1.06;
    margin-bottom: 14px;
  }
  .au-head p {
    font-size: var(--fs-lead);
    color: var(--ink-60);
  }
  .au-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
  }
  .au-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--ink-12);
    border-radius: 20px;
    padding: 26px 24px;
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .au-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(20, 18, 16, 0.1);
    border-color: rgba(232, 93, 42, 0.35);
  }
  .au-card h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--fs-h4);
    margin-bottom: 10px;
  }
  .au-card p {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--ink-60);
    margin-bottom: 18px;
  }
  .au-from {
    margin-top: auto;
    font-family: var(--body);
    font-size: var(--fs-small);
    color: var(--coral);
  }
</style>
