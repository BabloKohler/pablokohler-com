---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/wordmark-negro.png';
import type { Lang, UiDictionary } from '../i18n';

interface Props {
  lang: Lang;
  t: UiDictionary['nav'];
  /** Href al equivalente de esta página en el otro idioma (home u otro caso). */
  otherLangHref: string;
  /**
   * Si se pasa, el nav muestra "← volver" en vez de los links completos
   * (variante usada en las páginas de detalle de caso).
   */
  back?: { href: string; label: string };
}

const { lang, t, otherLangHref, back } = Astro.props;
const home = `/${lang}/`;
---

<nav>
  <a href={home} class="brand">
    <Image src={wordmark} alt="Pablo Kohler" height={22} format="webp" quality={90} />
  </a>

  {
    back ? (
      <div class="back-group">
        <a href={back.href} class="back">
          {back.label}
        </a>
        <a href={otherLangHref} class="lang">
          <b>{t.langLabel}</b> / <span>{lang === 'es' ? 'EN' : 'ES'}</span>
        </a>
      </div>
    ) : (
      <>
        <button class="menu-toggle" id="nav-menu-toggle" aria-expanded="false" aria-controls="nav-links">
          <span class="bar" />
          <span class="bar" />
          <span class="bar" />
          <span class="sr-only" data-open-label={t.menuOpen} data-close-label={t.menuClose}>
            {t.menuOpen}
          </span>
        </button>
        <div class="nav-links" id="nav-links">
          <a href={`${home}#trabajo`}>{t.work}</a>
          <a href={`${home}#servicios`}>{t.services}</a>
          <a href={`${home}#sobre-mi`}>{t.about}</a>
          <a href={`/${lang}/blog/`}>{t.blog}</a>
          <a href={`${home}#contacto`}>{t.contact}</a>
        </div>
        <a href={otherLangHref} class="lang">
          <b>{t.langLabel}</b> / <span>{lang === 'es' ? 'EN' : 'ES'}</span>
        </a>
      </>
    )
  }
</nav>

{
  !back && (
    <script>
      const toggle = document.getElementById('nav-menu-toggle');
      const links = document.getElementById('nav-links');
      if (toggle && links) {
        const label = toggle.querySelector('.sr-only') as HTMLElement | null;
        const setOpen = (open: boolean) => {
          links.classList.toggle('open', open);
          toggle.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
          if (label) {
            label.textContent = open ? label.dataset.closeLabel ?? '' : label.dataset.openLabel ?? '';
          }
        };
        toggle.addEventListener('click', () => setOpen(!links.classList.contains('open')));
        links.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName === 'A') setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      }
    </script>
  )
}

<style>
  nav {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px clamp(24px, 5vw, 72px);
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .brand :global(img) {
    display: block;
    width: auto;
    height: 22px;
  }
  .back-group {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .back {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--ink-60);
    text-decoration: none;
    transition: color 0.18s;
  }
  .back:hover {
    color: var(--coral);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .nav-links a {
    color: var(--ink-60);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .lang {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-40);
    border: 1px solid var(--ink-12);
    border-radius: 100px;
    padding: 5px 12px;
    display: flex;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .lang b {
    color: var(--ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid var(--ink-12);
    border-radius: 10px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .menu-toggle .bar {
    width: 18px;
    height: 2px;
    background: var(--ink);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  .menu-toggle.open .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.open .bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.open .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      background: var(--paper);
      border-bottom: 1px solid var(--ink-12);
      padding: 8px clamp(24px, 5vw, 72px) 20px;
    }
    .nav-links.open {
      display: flex;
    }
    .nav-links a {
      padding: 10px 0;
      width: 100%;
    }
    .menu-toggle {
      display: flex;
    }
  }
</style>
