---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/wordmark-negro.png';
import type { Lang, UiDictionary } from '../i18n';

interface Props {
  lang: Lang;
  t: UiDictionary['nav'];
  /** Href al equivalente de esta página en el otro idioma (home u otro caso). */
  otherLangHref: string;
  /**
   * Si se pasa, el nav muestra "← volver" en vez de los links completos
   * (variante usada en las páginas de detalle de caso).
   */
  back?: { href: string; label: string };
}

const { lang, t, otherLangHref, back } = Astro.props;
const home = `/${lang}/`;
---

<nav>
  <a href={home} class="brand">
    <Image src={wordmark} alt="Pablo Kohler" height={22} format="webp" quality={90} />
  </a>

  {
    back ? (
      <div class="back-group">
        <a href={back.href} class="back">
          {back.label}
        </a>
        <a href={otherLangHref} class="lang">
          <b>{t.langLabel}</b> / <span>{lang === 'es' ? 'EN' : 'ES'}</span>
        </a>
      </div>
    ) : (
      <>
        <button class="menu-toggle" id="nav-menu-toggle" aria-expanded="false" aria-controls="nav-links">
          <span class="bar" />
          <span class="bar" />
          <span class="bar" />
          <span class="sr-only" data-open-label={t.menuOpen} data-close-label={t.menuClose}>
            {t.menuOpen}
          </span>
        </button>
        <div class="nav-links" id="nav-links">
          <a href={`${home}#servicios`}>{t.services}</a>
          <a href={`${home}#trabajo`}>{t.work}</a>
          <a href={`${home}#sobre-mi`}>{t.about}</a>
          <a href={`${home}#contacto`}>{t.contact}</a>
        </div>
        <a href={otherLangHref} class="lang">
          <b>{t.langLabel}</b> / <span>{lang === 'es' ? 'EN' : 'ES'}</span>
        </a>
      </>
    )
  }
</nav>

{
  !back && (
    <script>
      const toggle = document.getElementById('nav-menu-toggle');
      const links = document.getElementById('nav-links');
      if (toggle && links) {
        const label = toggle.querySelector('.sr-only') as HTMLElement | null;
        const setOpen = (open: boolean) => {
          links.classList.toggle('open', open);
          toggle.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
          if (label) {
            label.textContent = open ? label.dataset.closeLabel ?? '' : label.dataset.openLabel ?? '';
          }
        };
        toggle.addEventListener('click', () => setOpen(!links.classList.contains('open')));
        links.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName === 'A') setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      }
    </script>
  )
}

<script>
  // El nav es una píldora flotante — se compacta un poco (menos padding, más sombra) apenas el
  // usuario empieza a scrollear, para reforzar que "está flotando" sobre el contenido. Estado
  // fijo (sin transición) bajo prefers-reduced-motion, mismo criterio que el resto del sitio.
  const navEl = document.querySelector<HTMLElement>('nav');
  if (navEl) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ticking = false;
    const update = () => {
      navEl.classList.toggle('is-scrolled', window.scrollY > 40);
      ticking = false;
    };
    update();
    if (!reduceMotion) {
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        },
        { passive: true },
      );
    }
  }
</script>

<style>
  nav {
    position: fixed;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 36px);
    max-width: calc(100vw - 28px);
    padding: 13px 22px;
    border-radius: 100px;
    background: rgba(250, 246, 240, 0.82);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid var(--ink-12);
    box-shadow: 0 8px 30px rgba(20, 18, 16, 0.08);
    transition:
      padding 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }
  nav.is-scrolled {
    padding: 10px 20px;
    background: rgba(250, 246, 240, 0.94);
    box-shadow: 0 10px 34px rgba(20, 18, 16, 0.14);
  }
  @media (prefers-reduced-motion: reduce) {
    nav {
      transition: none;
    }
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .brand :global(img) {
    display: block;
    width: auto;
    height: 22px;
  }
  .back-group {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .back {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--ink-60);
    text-decoration: none;
    transition: color 0.18s;
  }
  .back:hover {
    color: var(--coral);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .nav-links a {
    color: var(--ink-60);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .lang {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-40);
    border: 1px solid var(--ink-12);
    border-radius: 100px;
    padding: 5px 12px;
    display: flex;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .lang b {
    color: var(--ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid var(--ink-12);
    border-radius: 10px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .menu-toggle .bar {
    width: 18px;
    height: 2px;
    background: var(--ink);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  .menu-toggle.open .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.open .bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.open .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      min-width: 220px;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      background: var(--paper);
      border: 1px solid var(--ink-12);
      border-radius: 20px;
      box-shadow: 0 12px 34px rgba(20, 18, 16, 0.12);
      padding: 10px 20px 14px;
    }
    .nav-links.open {
      display: flex;
    }
    .nav-links a {
      padding: 10px 0;
      width: 100%;
    }
    .menu-toggle {
      display: flex;
    }
  }
</style>
