---
import type { UiDictionary } from '../../i18n';

interface Props {
  t: UiDictionary['caps'];
}
const { t } = Astro.props;

// Un color de acento por pilar — título, numeral y punto de progreso del carrusel comparten
// el mismo trío que ya usa el resto del sitio.
const accentColors = ['var(--coral)', 'var(--amber)', 'var(--magenta)'];
const accentWash = ['rgba(232, 93, 42, 0.05)', 'rgba(245, 166, 35, 0.06)', 'rgba(212, 53, 107, 0.05)'];
const panelCount = t.cards.length;
---

<section class="caps" id="servicios">
  <div class="caps-head">
    <h2>{t.headline} <span class="accent">{t.headlineAccent}</span></h2>
    <p class="caps-intro">{t.intro}</p>
  </div>

  <div class="carousel-track-outer" style={`height:${panelCount * 100}vh`}>
    <div class="carousel-sticky">
      <div class="carousel-track" style={`width:${panelCount * 100}%`}>
        {
          t.cards.map((card, i) => (
            <article
              class="panel reveal"
              data-reveal
              style={`width:${100 / panelCount}%; background: linear-gradient(180deg, ${accentWash[i]}, var(--paper) 70%)`}
            >
              <span class="panel-num" aria-hidden="true">
                {card.num}
              </span>
              <span class="panel-title" style={`color:${accentColors[i]}`}>
                {card.title}
              </span>
              <p class="panel-lead">{card.lead}</p>
              <p class="panel-desc">{card.desc}</p>
              <ul class="panel-list">
                {card.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <div class="carousel-dots" aria-hidden="true">
        {
          t.cards.map((_, i) => (
            <span class="dot" style={`--dot-color:${accentColors[i]}`} />
          ))
        }
      </div>
    </div>
  </div>

  <div class="caps-foot">
    <p>{t.footText}</p>
    <a href="#contacto" class="caps-link">{t.footLink}</a>
  </div>
</section>

<script>
  // Carrusel horizontal manejado por scroll vertical: mismo patrón rAF-throttled que ya usan
  // Hero.astro/Contact.astro para su parallax. Desactivado por completo en mobile y bajo
  // prefers-reduced-motion (ver CSS): ahí el track vuelve a flujo normal y los paneles se
  // apilan, cada uno con su propio fade (reusa el observer global de BaseLayout.astro).
  const outer = document.querySelector<HTMLElement>('.carousel-track-outer');
  const track = document.querySelector<HTMLElement>('.carousel-track');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.carousel-dots .dot'));
  const panelCount = track?.children.length ?? 0;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isNarrow = window.matchMedia('(max-width: 760px)').matches;

  if (outer && track && panelCount > 1 && !reduceMotion && !isNarrow) {
    let ticking = false;
    const update = () => {
      const rect = outer.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 0;
      track.style.transform = `translateX(-${progress * ((panelCount - 1) / panelCount) * 100}%)`;

      const activeIndex = Math.min(panelCount - 1, Math.round(progress * (panelCount - 1)));
      dots.forEach((d, i) => d.classList.toggle('is-active', i === activeIndex));
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', () => requestAnimationFrame(update));
  }
</script>

<style>
  .caps {
    position: relative;
    z-index: 2;
    padding: clamp(80px, 12vh, 140px) 0 clamp(60px, 8vh, 100px);
  }
  .caps-head {
    max-width: 640px;
    margin: 0 auto clamp(48px, 7vh, 80px);
    padding: 0 clamp(24px, 5vw, 72px);
  }
  .caps h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(30px, 4.4vw, 54px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .caps-intro {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--ink-60);
  }

  /* Carrusel: el riel (track-outer) da la distancia de scroll vertical; el sticky queda fijo
     en el viewport mientras tanto; el track se desplaza en horizontal según el progreso. */
  .carousel-track-outer {
    position: relative;
  }
  .carousel-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .carousel-track {
    display: flex;
    height: 100%;
    will-change: transform;
  }
  .panel {
    position: relative;
    flex-shrink: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 clamp(24px, 6vw, 96px);
  }
  .panel-num {
    position: absolute;
    top: 6%;
    left: clamp(24px, 6vw, 96px);
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(90px, 14vw, 200px);
    line-height: 1;
    color: var(--ink-12);
    z-index: 0;
    user-select: none;
  }
  .panel-title {
    position: relative;
    z-index: 1;
    display: block;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .panel-lead {
    position: relative;
    z-index: 1;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(30px, 4.6vw, 58px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 13ch;
    margin-bottom: 22px;
  }
  .panel-desc {
    position: relative;
    z-index: 1;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.6;
    color: var(--ink-60);
    max-width: 46ch;
    margin-bottom: 28px;
  }
  .panel-list {
    position: relative;
    z-index: 1;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .panel-list li {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-60);
    padding: 7px 16px;
    border: 1px solid var(--ink-12);
    border-radius: 100px;
    background: #fff;
  }

  .carousel-dots {
    position: absolute;
    bottom: clamp(24px, 4vh, 40px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 2;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-12);
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }
  .dot.is-active {
    background: var(--dot-color, var(--coral));
    transform: scale(1.3);
  }

  /* Mobile: el scroll horizontal manejado por JS es mala práctica en touch (pelea con el swipe
     nativo). El track vuelve a flujo normal, los paneles se apilan y cada uno hace su propio
     fade con el observer global (misma clase .reveal que ya usan Formats/Cases/About). */
  @media (max-width: 760px) {
    .carousel-track-outer {
      height: auto !important;
    }
    .carousel-sticky {
      position: static;
      height: auto;
      overflow: visible;
      display: block;
    }
    .carousel-track {
      display: block;
      width: 100% !important;
      transform: none !important;
    }
    .panel {
      width: 100% !important;
      height: auto;
      padding: 40px clamp(24px, 6vw, 48px);
    }
    .panel-num {
      position: static;
      display: block;
      font-size: clamp(56px, 22vw, 90px);
      margin-bottom: -16px;
    }
    .carousel-dots {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-track-outer {
      height: auto !important;
    }
    .carousel-sticky {
      position: static !important;
      height: auto !important;
      overflow: visible !important;
    }
    .carousel-track {
      display: block !important;
      width: 100% !important;
      transform: none !important;
    }
    .panel {
      width: 100% !important;
      height: auto !important;
    }
    .carousel-dots {
      display: none;
    }
  }

  .caps-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 1200px;
    margin: clamp(48px, 7vh, 80px) auto 0;
    padding: 32px clamp(24px, 5vw, 72px) 0;
    border-top: 1px solid var(--ink-12);
  }
  .caps-foot p {
    font-size: 16px;
    color: var(--ink-60);
  }
  .caps-link {
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.18s;
  }
  .caps-link:hover {
    color: var(--coral);
  }
</style>
