---
import Star from '../Star.astro';
import { STAR_VIEWBOX } from '../star-path';
import type { UiDictionary } from '../../i18n';

interface Props {
  t: UiDictionary['hero'];
}
const { t } = Astro.props;

// Tamaño responsive a partir del tamaño máximo en escritorio (px): clamp(mín, vw, máx).
const sz = (max: number, minRatio = 0.6) => `clamp(${Math.round(max * minRatio)}px, ${(max / 14.4).toFixed(2)}vw, ${max}px)`;

/**
 * Los soles del hero. 3 planos de profundidad:
 *  - Gigantes (2): ~8x los soles originales (150px / 96px). Fondo monumental, recortado por los bordes,
 *    se mueven despacio (profundidad lejana).
 *  - Medianos y pequeños (8): cerca de la cámara, se mueven más rápido y reaccionan más al cursor.
 * `speed` = factor de desplazamiento vertical con el scroll (negativo = sube mientras se hace scroll abajo),
 * `rot` = grados de rotación extra por px de scroll.
 * `spin` = segundos por vuelta (CSS), `rev` = sentido antihorario.
 */
const suns = [
  // Gigantes: viven en el borde derecho e inferior; la columna del texto (izquierda) queda sobre fondo limpio.
  { size: 'clamp(520px, 84vw, 1200px)', color: 'var(--coral)', pos: 'top:-36%;right:-46%', mpos: 'top:-52%;right:-46%', spin: 150, rev: false, speed: 0.1, rot: 0.012, giant: true },
  { size: 'clamp(360px, 60vw, 860px)', color: 'var(--amber)', pos: 'bottom:-78%;left:36%', mpos: 'bottom:-36%;left:-14%', spin: 190, rev: true, speed: 0.18, rot: -0.016, giant: true },
  // Medianos
  { size: sz(150), color: 'var(--magenta)', pos: 'top:60%;right:9%', mpos: 'top:78%;right:8%', spin: 108, rev: false, speed: 0.42, rot: 0.05 },
  { size: sz(110), color: 'var(--amber)', pos: 'top:9%;left:47%', mpos: 'top:14%;left:42%', spin: 90, rev: true, speed: -0.14, rot: -0.04 },
  { size: sz(96), color: 'var(--coral)', pos: 'bottom:7%;right:30%', mpos: 'bottom:5%;right:30%', spin: 77, rev: true, speed: 0.62, rot: 0.06 },
  // Pequeños
  { size: sz(72), color: 'var(--magenta)', pos: 'top:12%;left:8%', mpos: 'top:15%;left:6%', spin: 64, rev: false, speed: 0.3, rot: -0.07 },
  { size: sz(52), color: 'var(--coral)', pos: 'top:44%;left:55%', mpos: 'top:24%;left:12%', spin: 52, rev: true, speed: -0.28, rot: 0.08 },
  { size: sz(40), color: 'var(--amber)', pos: 'bottom:22%;left:36%', mpos: 'top:84%;left:10%', spin: 46, rev: false, speed: 0.85, rot: -0.09 },
  { size: sz(30), color: 'var(--magenta)', pos: 'top:24%;right:33%', mpos: 'top:21%;left:34%', spin: 38, rev: true, speed: -0.5, rot: 0.1 },
  { size: sz(60), color: 'var(--amber)', pos: 'top:80%;left:25%', mpos: 'top:72%;left:72%', spin: 58, rev: false, speed: 0.55, rot: 0.07 },
];

// Posiciones y tamaños en CSS (escritorio + móvil). En móvil el hero es alto y angosto: los soles se
// reparten arriba y abajo para no pisar el texto. `!important` porque se resetean los 4 lados.
const sunCss = suns
  .map(
    (s, i) =>
      `.hero .sun[data-i="${i}"]{${s.pos};width:${s.size}}` +
      `@media (max-width:700px){.hero .sun[data-i="${i}"]{top:auto!important;right:auto!important;bottom:auto!important;left:auto!important;${s.mpos.replace(/;/g, ' !important;')} !important}}`,
  )
  .join('');

---

<header class="hero">

  <style is:inline set:html={sunCss}></style>

  <div class="suns" aria-hidden="true">
    {
      suns.map((s, i) => (
        <div
          class:list={['sun', { 'sun--giant': s.giant }]}
          style={`--i:${i}`}
          data-i={i}
          data-speed={s.speed}
          data-rot={s.rot}
        >
          <div class="sun-pos">
            <div class="sun-pop">
              <svg
                viewBox={STAR_VIEWBOX}
                style={`fill:${s.color};animation:${s.rev ? 'star-spin-rev' : 'star-spin'} ${s.spin}s linear infinite`}
              >
                <use href="#slp-star" />
              </svg>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="hero-inner">
    <h1>{t.headline}{/^[,.;:]/.test(t.headlineAccent) ? '' : ' '}<span class="accent">{t.headlineAccent}</span></h1>
    <p class="sub">{t.sub}</p>
    <div class="cta-row">
      <a href="#contacto" class="btn btn-primary">
        <Star class="btn-sun" size="77px" color="var(--sun-color, var(--coral))" />
        <span class="btn-label">{t.ctaPrimary}</span> <span class="arrow">→</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { initSunField } from '../../scripts/sun-field';

  const hero = document.querySelector<HTMLElement>('.hero');
  const root = hero?.querySelector<HTMLElement>('.suns');
  if (hero && root) {
    const start = () => initSunField({ root, section: hero, mode: 'hero' });
    const idle = (cb: () => void) => ('requestIdleCallback' in window ? window.requestIdleCallback(cb, { timeout: 1500 }) : setTimeout(cb, 300));
    if (document.readyState === 'complete') idle(start);
    else window.addEventListener('load', () => idle(start), { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 88px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(96px, 14vh, 140px) clamp(24px, 5vw, 72px) 60px;
    overflow: hidden;
  }

  /* Capa de soles: detrás del contenido, sin capturar el mouse (el hover se calcula por distancia).
     Tres transforms en capas distintas para que no se pisen:
       .sun-pos  → JS: scroll + mouse + hover
       .sun-pop  → CSS: entrada escalonada
       svg       → CSS: giro continuo */
  .suns {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .sun {
    position: absolute;
  }
  .sun-pos {
    will-change: transform;
  }
  .sun-pop {
    animation: sun-in 1.15s cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
    animation-delay: calc(var(--i) * 85ms + 120ms);
    transform-origin: center;
  }
  .sun--giant .sun-pop {
    animation-duration: 1.8s;
    animation-delay: calc(var(--i) * 140ms);
  }
  .sun svg {
    display: block;
    width: 100%;
    height: auto;
    will-change: transform;
    transform-origin: center;
  }
  @keyframes sun-in {
    from {
      opacity: 0;
      transform: scale(0.15) rotate(-120deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sun-pop {
      animation: none;
    }
    .sun svg {
      animation: none !important;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    /* El texto del hero no se selecciona (así no estorba al arrastrar los soles). El botón sigue funcionando. */
    -webkit-user-select: none;
    user-select: none;
  }

  h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--fs-display);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 16ch;
    margin-bottom: 32px;
  }

  .sub {
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--ink-60);
    max-width: 52ch;
    margin-bottom: 40px;
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
</style>
