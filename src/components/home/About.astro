---
import { Image } from 'astro:assets';
import portrait from '../../assets/about/pablo-kohler.jpg';
import type { UiDictionary } from '../../i18n';

interface Props {
  t: UiDictionary['about'];
}
const { t } = Astro.props;

// Los diccionarios de i18n usan **texto** para negrita dentro de los párrafos de bio.
const mdBold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<section class="about" id="sobre-mi">
  <div class="about-grid">
    <div class="about-media">
      <div class="about-photo">
        <Image src={portrait} alt="Pablo Kohler" width={900} format="webp" quality={85} />
      </div>
      <div class="about-facts">
        {
          t.facts.map((f) => (
            <div class="fact">
              <span class="fact-n">{f.n}</span>
              <span class="fact-l">{f.l}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="about-text">
      <h2>{t.headline} <span class="accent">{t.headlineAccent}</span></h2>
      {t.paragraphs.map((p) => <p set:html={mdBold(p)} />)}
      <a href="#contacto" class="about-cta">{t.cta}</a>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    z-index: 2;
    padding: clamp(60px, 9vh, 110px) clamp(24px, 5vw, 72px);
    max-width: 1200px;
    margin: 0 auto;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .about-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--ink-12);
  }
  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-facts {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }
  .fact {
    flex: 1;
    background: #fff;
    border: 1px solid var(--ink-12);
    border-radius: 14px;
    padding: 14px 12px;
    text-align: center;
  }
  .fact-n {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
    background: linear-gradient(105deg, var(--coral), var(--amber));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .fact-l {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-60);
    margin-top: 4px;
    line-height: 1.3;
  }

  .about-text h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(28px, 3.8vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .about-text p {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.65;
    color: var(--ink-60);
    margin-bottom: 18px;
  }
  .about-text p :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .about-cta {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--coral);
    padding-bottom: 2px;
    transition: color 0.18s;
  }
  .about-cta:hover {
    color: var(--coral);
  }
</style>
