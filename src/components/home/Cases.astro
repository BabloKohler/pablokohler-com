---
import Star from '../Star.astro';
import type { CollectionEntry } from 'astro:content';
import type { Lang, UiDictionary } from '../../i18n';

interface Props {
  t: UiDictionary['cases'];
  lang: Lang;
  cases: CollectionEntry<'cases-es' | 'cases-en'>[];
}
const { t, lang, cases } = Astro.props;
const casesPathSegment = lang === 'es' ? 'casos' : 'cases';
---

<section class="cases" id="trabajo">
  <div class="cases-head">
    <h2>{t.headline} <span class="accent">{t.headlineAccent}</span></h2>
    <p class="caps-intro">{t.intro}</p>
  </div>

  <div class="cases-grid">
    {
      cases.map((c) => (
        <a href={`/${lang}/${casesPathSegment}/${c.id}`} class="case">
          <div class={`case-media ${c.data.coverVariant === 'alt' ? 'alt' : ''}`}>
            {
              c.data.coverImage ? (
                <img class="case-img" src={c.data.coverImage} alt="" />
              ) : (
                <Star class="case-star" color={c.data.coverVariant === 'alt' ? 'var(--magenta)' : 'var(--coral)'} opacity={0.5} />
              )
            }
            <span class="case-tag">{c.data.tags[0]}</span>
          </div>
          <div class="case-body">
            <div class="case-metric">
              <span class="metric-descriptor">{c.data.cardMetricDescriptor}</span>
              <span class="metric-label">{c.data.cardMetricLabel}</span>
            </div>
            <h3>{c.data.title}</h3>
            <p>{c.data.cardDescription}</p>
            <span class="case-cta">{t.viewCase}</span>
          </div>
        </a>
      ))
    }
  </div>

  <div class="cases-more">
    <span class="mono-note">{t.more}</span>
  </div>
</section>

<style>
  .cases {
    position: relative;
    z-index: 2;
    padding: clamp(60px, 8vh, 100px) clamp(24px, 5vw, 72px) clamp(80px, 12vh, 140px);
    max-width: 1200px;
    margin: 0 auto;
  }
  .cases-head {
    max-width: 680px;
    margin-bottom: 44px;
  }
  .cases h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(30px, 4.4vw, 54px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
  }
  @media (max-width: 760px) {
    .cases-grid {
      grid-template-columns: 1fr;
    }
  }

  .case {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--ink-12);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .case:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(20, 18, 16, 0.1);
    border-color: rgba(232, 93, 42, 0.35);
  }

  .case-media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, #ffe8dc, #fdf0d8);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .case-media.alt {
    background: linear-gradient(135deg, #fde4ce, #fbd9e6);
  }
  .case :global(.case-star) {
    width: 72px;
    height: 72px;
  }
  .case-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-60);
    background: rgba(255, 255, 255, 0.85);
    padding: 5px 10px;
    border-radius: 100px;
    backdrop-filter: blur(4px);
  }

  .case-body {
    padding: 26px 26px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .case-metric {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--ink-12);
  }
  .metric-descriptor {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
    background: linear-gradient(105deg, var(--coral), var(--amber));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .metric-label {
    font-size: 13px;
    color: var(--ink-60);
    font-family: var(--mono);
  }

  .case-body h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  .case-body p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-60);
    margin-bottom: 18px;
    flex: 1;
  }
  .case-cta {
    font-family: var(--display);
    font-weight: 600;
    font-size: 15px;
    color: var(--coral);
    transition: transform 0.18s;
    display: inline-block;
  }
  .case:hover .case-cta {
    transform: translateX(4px);
  }

  .cases-more {
    margin-top: 32px;
    text-align: center;
  }
</style>
