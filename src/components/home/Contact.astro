---
import Star from '../Star.astro';
import type { UiDictionary } from '../../i18n';

interface Props {
  t: UiDictionary['contact'];
}
const { t } = Astro.props;

// Configura PUBLIC_FORMSPREE_ID en .env (ver .env.example) con el ID de tu formulario
// del plan gratis de Formspree. Mientras no exista, el form avisa que aún no está
// conectado en vez de fallar en silencio (ver script más abajo).
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const formAction = formspreeId ? `https://formspree.io/f/${formspreeId}` : undefined;

const formStrings = JSON.stringify({
  sending: t.form.sending,
  success: t.form.success,
  error: t.form.error,
  notConfigured: t.form.notConfigured,
});
---

<section class="contact" id="contacto">
  <div class="star-edge star-edge--tr" data-parallax="0.15">
    <Star class="star-mark" size="clamp(90px, 10vw, 140px)" color="var(--coral)" spin duration={108} />
  </div>
  <div class="star-edge star-edge--bl" data-parallax="0.1">
    <Star class="star-echo" size="clamp(56px, 6vw, 88px)" color="var(--amber)" spin duration={77} reverse />
  </div>
  <div class="star-edge star-edge--ml" data-parallax="0.22">
    <Star class="star-side" size="clamp(48px, 5.5vw, 76px)" color="var(--magenta)" spin duration={92} />
  </div>

  <div class="contact-inner">
    <h2>{t.headline}<br /><span class="accent">{t.headlineAccent}</span></h2>
    <p class="contact-sub">{t.sub}</p>

    <div class="contact-cols">
      <form
        class="contact-form"
        id="contact-form"
        action={formAction}
        method="POST"
        data-configured={formAction ? 'true' : 'false'}
        data-strings={formStrings}
      >
        <div class="field">
          <label for="name">{t.form.name}</label>
          <input id="name" name="name" type="text" placeholder={t.form.namePlaceholder} required />
        </div>
        <div class="field">
          <label for="email">{t.form.email}</label>
          <input id="email" name="email" type="email" placeholder={t.form.emailPlaceholder} required />
        </div>
        <div class="field">
          <label for="message">{t.form.message}</label>
          <textarea id="message" name="message" rows="4" placeholder={t.form.messagePlaceholder} required></textarea>
        </div>
        <button class="btn btn-primary form-btn" type="submit">
          <Star class="btn-sun" size="77px" color="var(--sun-color, var(--coral))" />
          <span class="btn-label">{t.form.submit}</span>
        </button>
        <p class="form-status" role="status" aria-live="polite" />
        <span class="form-note">{t.form.note}</span>
      </form>

      <div class="contact-direct">
        <p class="direct-label">{t.directLabel}</p>
        <a href="https://calendly.com/pablokohlerlara/30min" class="direct-link">
          <span class="dl-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M8 3v4M16 3v4M3 10h18"></path>
            </svg>
          </span>
          <span>
            <strong>{t.calendlyTitle}</strong><br />{t.calendlySub}
          </span>
        </a>
        <a href="https://www.linkedin.com/in/pablo-kohler/" class="direct-link">
          <span class="dl-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.6v1.7h.05c.5-.9 1.7-1.9 3.5-1.9 3.7 0 4.4 2.4 4.4 5.6V21h-4v-5.7c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3v5.8H9z"></path>
            </svg>
          </span>
          <span>
            <strong>{t.linkedinTitle}</strong><br />{t.linkedinSub}
          </span>
        </a>
      </div>
    </div>
  </div>

  <footer class="site-footer">
    <div class="foot-brand">
      <Star class="foot-star" size="14px" color="var(--coral)" />
      Pablo Kohler
    </div>
    <span class="foot-copy">{t.footerCopy}</span>
  </footer>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const contactEdges = document.querySelectorAll<HTMLElement>('.contact .star-edge');

  if (!reduceMotion && contactEdges.length) {
    let contactTicking = false;
    const updateContactEdges = () => {
      const y = window.scrollY;
      contactEdges.forEach((el) => {
        const factor = parseFloat(el.dataset.parallax ?? '0');
        el.style.transform = `translateY(${y * factor}px)`;
      });
      contactTicking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!contactTicking) {
          requestAnimationFrame(updateContactEdges);
          contactTicking = true;
        }
      },
      { passive: true },
    );
  }

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const statusEl = form.querySelector('.form-status') as HTMLElement | null;
    const submitBtn = form.querySelector('.form-btn') as HTMLButtonElement | null;
    const submitLabel = submitBtn?.querySelector('.btn-label') as HTMLElement | null;
    const strings = JSON.parse(form.dataset.strings ?? '{}');
    const configured = form.dataset.configured === 'true';
    const originalLabel = submitLabel?.textContent ?? '';

    const setStatus = (text: string, state: 'info' | 'success' | 'error') => {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.dataset.state = state;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!configured) {
        setStatus(strings.notConfigured, 'info');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
      }
      if (submitLabel) {
        submitLabel.textContent = strings.sending;
      }
      setStatus('', 'info');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          setStatus(strings.success, 'success');
          form.reset();
        } else {
          setStatus(strings.error, 'error');
        }
      } catch {
        setStatus(strings.error, 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
        }
        if (submitLabel) {
          submitLabel.textContent = originalLabel;
        }
      }
    });
  }
</script>

<style>
  .contact {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    margin-top: clamp(40px, 6vh, 80px);
    padding: clamp(70px, 10vh, 120px) clamp(24px, 5vw, 72px) 0;
    overflow: hidden;
  }
  .star-edge {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    will-change: transform;
  }
  .star-edge--tr {
    top: -24px;
    right: -24px;
  }
  .star-edge--bl {
    bottom: -14px;
    left: -14px;
  }
  .star-edge--ml {
    top: 46%;
    left: -30px;
  }
  .contact-inner {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
  }
  .contact h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(32px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 18px;
  }
  .contact-sub {
    font-size: clamp(16px, 1.4vw, 19px);
    color: rgba(250, 246, 240, 0.6);
    margin-bottom: 48px;
  }

  .contact-cols {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  @media (max-width: 820px) {
    .contact-cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .field {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
  }
  .field label {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(250, 246, 240, 0.5);
    margin-bottom: 8px;
  }
  .field input,
  .field textarea {
    background: rgba(250, 246, 240, 0.06);
    border: 1px solid rgba(250, 246, 240, 0.15);
    border-radius: 12px;
    padding: 14px 16px;
    color: var(--paper);
    font-family: var(--body);
    font-size: 15px;
    transition: border-color 0.18s;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--coral);
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: rgba(250, 246, 240, 0.3);
  }
  .form-btn {
    border: 1px solid var(--paper);
    cursor: pointer;
    margin-top: 4px;
  }
  .form-status {
    font-family: var(--mono);
    font-size: 13px;
    margin-top: 12px;
    min-height: 1em;
  }
  .form-status[data-state='success'] {
    color: var(--amber);
  }
  .form-status[data-state='error'],
  .form-status[data-state='info'] {
    color: var(--coral);
  }
  .form-note {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    color: rgba(250, 246, 240, 0.5);
    margin-top: 8px;
  }

  .direct-label {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(250, 246, 240, 0.5);
    margin-bottom: 16px;
  }
  .direct-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid rgba(250, 246, 240, 0.15);
    border-radius: 14px;
    margin-bottom: 12px;
    text-decoration: none;
    color: var(--paper);
    transition:
      border-color 0.18s,
      background 0.18s;
  }
  .direct-link:hover {
    border-color: var(--coral);
    background: rgba(232, 93, 42, 0.08);
  }
  .dl-icon {
    flex-shrink: 0;
    color: var(--paper);
  }
  .dl-icon svg {
    width: 22px;
    height: 22px;
    display: block;
  }
  .direct-link span {
    font-size: 14px;
    line-height: 1.4;
    color: rgba(250, 246, 240, 0.7);
  }
  .direct-link strong {
    color: var(--paper);
    font-weight: 600;
  }

  .site-footer {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: clamp(60px, 9vh, 110px) auto 0;
    padding: 28px 0;
    border-top: 1px solid rgba(250, 246, 240, 0.12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
  }
  .foot-brand :global(.foot-star) {
    flex-shrink: 0;
  }
  .foot-copy {
    font-family: var(--mono);
    font-size: 12px;
    color: rgba(250, 246, 240, 0.4);
  }
</style>
