---
import type { UiDictionary } from '../../i18n';

interface Props {
  t: UiDictionary['trust'];
}
const { t } = Astro.props;

const clients = [
  { name: 'Vetro Chile', logo: '/logos/vetro-chile.png' },
  { name: 'Rangitaki', logo: '/logos/rangitaki.png' },
  { name: 'Proyecto Alquimia', logo: '/logos/alquimia.png' },
  { name: 'Fundación Huella Animal', logo: '/logos/huella-animal.png' },
  { name: 'UC Chile', logo: '/logos/uc.png' },
  { name: 'Docomomo', logo: '/logos/docomomo.png' },
];

// El track se repite 8 veces (no 2) para que el set nunca sea más angosto que la
// pantalla — si lo fuera, después de una vuelta se ve un hueco vacío antes de que
// vuelva a aparecer el siguiente set. Con 8 copias el keyframe avanza -12.5% (1/8).
const repeatedSets = Array.from({ length: 8 }, (_, i) => i);
---

<section class="trust">
  <p class="trust-label">{t.label}</p>
  <div class="marquee" aria-label="Clientes">
    <div class="marquee-track">
      {
        repeatedSets.map((setIndex) =>
          clients.map((c) => (
            <img class="logo-item" src={c.logo} alt={setIndex === 0 ? c.name : ''} aria-hidden={setIndex === 0 ? undefined : 'true'} />
          )),
        )
      }
    </div>
  </div>
</section>

<style>
  .trust {
    position: relative;
    z-index: 2;
    padding: clamp(32px, 5vh, 56px) 0;
    border-top: 1px solid var(--ink-12);
    border-bottom: 1px solid var(--ink-12);
  }
  .trust-label {
    text-align: center;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-40);
    margin-bottom: 26px;
  }
  .marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .marquee-track {
    display: flex;
    align-items: center;
    gap: clamp(56px, 6vw, 100px);
    width: max-content;
    animation: marquee 60s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-12.5%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }
  }
  .logo-item {
    height: clamp(64px, 8vw, 88px);
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
    filter: grayscale(1) opacity(0.55);
    transition: filter 0.2s;
  }
  .logo-item:hover {
    filter: grayscale(0) opacity(1);
  }
</style>
