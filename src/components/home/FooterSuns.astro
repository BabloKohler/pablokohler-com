---
import { STAR_PATH, STAR_VIEWBOX } from '../star-path';

/**
 * Estrellitas de la banda inferior de la sección de contacto (detrás del footer), con la misma
 * interacción que las del hero (ver src/scripts/sun-field.ts): hover individual, arrastre con rebote
 * y movimiento propio con el scroll.
 * Posiciones en % de la banda (top/left); tamaños en px (las más grandes se asoman por encima del footer).
 */
const suns = [
  { size: 52, color: 'var(--coral)', pos: 'top:20%;left:2%', spin: 70, rev: false, speed: 0.5, rot: 0.05 },
  { size: 30, color: 'var(--amber)', pos: 'top:62%;left:7%', hideMobile: true, spin: 52, rev: true, speed: -0.4, rot: -0.06 },
  { size: 22, color: 'var(--magenta)', pos: 'top:38%;left:42%', spin: 44, rev: false, speed: 0.9, rot: 0.08 },
  { size: 64, color: 'var(--amber)', pos: 'top:6%;left:50%', spin: 96, rev: true, speed: 0.3, rot: -0.04 },
  { size: 26, color: 'var(--coral)', pos: 'top:36%;left:64%', hideMobile: true, spin: 48, rev: false, speed: -0.6, rot: 0.07 },
  { size: 44, color: 'var(--magenta)', pos: 'top:14%;left:76%', spin: 78, rev: true, speed: 0.55, rot: -0.05 },
  { size: 18, color: 'var(--amber)', pos: 'top:52%;left:93%', hideMobile: true, spin: 40, rev: false, speed: 0.95, rot: 0.09 },
  { size: 34, color: 'var(--coral)', pos: 'top:58%;left:70%', hideMobile: true, spin: 60, rev: true, speed: -0.3, rot: 0.06 },
];
---

<div class="foot-field" aria-hidden="true">
  <!-- Definición propia de la estrella (el id no se comparte con el hero) -->
  <svg width="0" height="0" style="position:absolute" focusable="false">
    <defs>
      <symbol id="footer-sun" viewBox={STAR_VIEWBOX}><path d={STAR_PATH}></path></symbol>
    </defs>
  </svg>
  {
    suns.map((s, i) => (
      <div class="sun" style={`${s.pos};width:${s.size}px;--i:${i}`} data-speed={s.speed} data-rot={s.rot} data-hide-mobile={s.hideMobile ? '' : undefined}>
        <div class="sun-pos">
          <div class="sun-pop">
            <svg viewBox={STAR_VIEWBOX} style={`fill:${s.color};animation:${s.rev ? 'star-spin-rev' : 'star-spin'} ${s.spin}s linear infinite`}>
              <use href="#footer-sun" />
            </svg>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  import { initSunField } from '../../scripts/sun-field';

  const root = document.querySelector<HTMLElement>('.foot-field');
  if (root) {
    // La interacción vale en toda la sección de contacto (que es la que recorta), no solo en la banda.
    initSunField({ root, section: root, bounds: root.closest<HTMLElement>('.contact') ?? root, mode: 'section' });
    // La entrada escalonada empieza cuando la banda aparece en pantalla.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          root.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    io.observe(root);
  }
</script>

<style>
  .foot-field {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(150px, 24vh, 240px);
    z-index: 1;
    pointer-events: none;
  }
  .sun {
    position: absolute;
  }
  .sun-pos {
    will-change: transform;
  }
  .sun-pop {
    opacity: 0;
    transform-origin: center;
  }
  .foot-field.is-in .sun-pop {
    animation: foot-sun-in 0.9s cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
    animation-delay: calc(var(--i) * 90ms);
  }
  .sun svg {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: center;
  }
  @keyframes foot-sun-in {
    from {
      opacity: 0;
      transform: scale(0.2) rotate(-100deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
  /* En móvil el texto del footer se apila en 3 líneas: las estrellitas de la fila baja se ocultan para no pisarlo. */
  @media (max-width: 700px) {
    .sun[data-hide-mobile] {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sun-pop {
      opacity: 1;
      animation: none !important;
    }
    .sun svg {
      animation: none !important;
    }
  }
</style>
