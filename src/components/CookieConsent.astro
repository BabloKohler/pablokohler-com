---
import type { Lang, UiDictionary } from '../i18n';

interface Props {
  lang: Lang;
  t: UiDictionary['cookieConsent'];
}
const { lang, t } = Astro.props;
const privacyHref = `/${lang}/${lang === 'es' ? 'privacidad' : 'privacy'}/`;
---

<div class="cookie-consent" id="cookie-consent" hidden>
  <p>
    {t.message}
    {' '}
    <a href={privacyHref}>{t.policyLink}</a>
  </p>
  <div class="cookie-actions">
    <button type="button" id="cookie-reject" class="cookie-btn cookie-btn--ghost">{t.reject}</button>
    <button type="button" id="cookie-accept" class="cookie-btn cookie-btn--primary">{t.accept}</button>
  </div>
</div>

<script>
  // Google Analytics 4 solo se carga con consentimiento explícito. Sin PUBLIC_GA_MEASUREMENT_ID
  // configurado (ver .env.example), este componente no hace nada — ni banner ni script.
  const GA_ID = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined)?.trim();
  const STORAGE_KEY = 'cookie_consent';

  const loadGoogleAnalytics = () => {
    if (!GA_ID || document.getElementById('ga4-script')) return;
    const script = document.createElement('script');
    script.id = 'ga4-script';
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(script);

    const w = window as unknown as { dataLayer: unknown[][] };
    w.dataLayer = w.dataLayer || [];
    const gtag = (...args: unknown[]) => w.dataLayer.push(args);
    gtag('js', new Date());
    gtag('config', GA_ID);
  };

  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');
  const stored = GA_ID ? localStorage.getItem(STORAGE_KEY) : 'rejected';

  if (stored === 'accepted') {
    loadGoogleAnalytics();
  } else if (!stored && GA_ID) {
    banner?.removeAttribute('hidden');
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'accepted');
    banner?.setAttribute('hidden', '');
    loadGoogleAnalytics();
  });

  rejectBtn?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'rejected');
    banner?.setAttribute('hidden', '');
  });
</script>

<style>
  .cookie-consent {
    position: fixed;
    left: 20px;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    max-width: 460px;
    margin: 0 auto;
    background: #fff;
    border: 1px solid var(--ink-12);
    border-radius: 20px;
    padding: 20px 22px;
    box-shadow: 0 18px 40px rgba(20, 18, 16, 0.14);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cookie-consent[hidden] {
    display: none;
  }
  .cookie-consent p {
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-60);
  }
  .cookie-consent p a {
    color: var(--coral);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cookie-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }
  .cookie-btn {
    appearance: none;
    font-family: var(--display);
    font-weight: 600;
    font-size: 13px;
    padding: 9px 18px;
    border-radius: 100px;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }
  .cookie-btn--primary {
    background: var(--ink);
    color: var(--paper);
  }
  .cookie-btn--primary:hover {
    transform: translateY(-1px);
  }
  .cookie-btn--ghost {
    background: transparent;
    border-color: var(--ink-12);
    color: var(--ink-60);
  }
  .cookie-btn--ghost:hover {
    color: var(--ink);
    border-color: var(--ink-40);
  }
  @media (max-width: 520px) {
    .cookie-consent {
      left: 12px;
      right: 12px;
      bottom: 12px;
      padding: 16px 18px;
    }
    .cookie-actions {
      justify-content: stretch;
    }
    .cookie-btn {
      flex: 1;
    }
  }
</style>
