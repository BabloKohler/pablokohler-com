---
interface Props {
  title: string;
  lead: string;
  tags: string[];
}
const { title, lead, tags } = Astro.props;
---

<header class="case-hero">
  <div class="case-tag-row">
    {tags.map((tag) => <span class="ctag">{tag}</span>)}
  </div>
  <h1>{title}</h1>
  <p class="case-lead">{lead}</p>
</header>

<style>
  .case-hero {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(30px, 5vh, 60px) clamp(24px, 5vw, 72px) clamp(30px, 4vh, 50px);
  }
  .case-tag-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .ctag {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-60);
    border: 1px solid var(--ink-12);
    border-radius: 100px;
    padding: 6px 14px;
  }
  .case-hero h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(34px, 5.5vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .case-lead {
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.6;
    color: var(--ink-60);
    max-width: 60ch;
  }
</style>
