---
interface Props {
  title: string;
  lead: string;
  tags: string[];
  /** Enlace al sitio real (casos de sitios web). */
  liveUrl?: string;
  liveLabel?: string;
}
const { title, lead, tags, liveUrl, liveLabel } = Astro.props;
---

<header class="case-hero">
  <div class="case-tag-row">
    {tags.map((tag) => <span class="ctag">{tag}</span>)}
  </div>
  <h1>{title}</h1>
  <p class="case-lead">{lead}</p>
  {
    liveUrl && liveLabel && (
      <a class="live-link" href={liveUrl} target="_blank" rel="noopener" data-track="live_site_click" data-track-location="case_hero">
        {liveLabel}
        <span aria-hidden="true">↗</span>
      </a>
    )
  }
</header>

<style>
  .case-hero {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(100px, 15vh, 150px) clamp(24px, 5vw, 72px) clamp(30px, 4vh, 50px);
  }
  .case-tag-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .ctag {
    font-family: var(--body);
    font-size: var(--fs-small);
    color: var(--ink-60);
    border: 1px solid var(--ink-12);
    border-radius: 100px;
    padding: 6px 14px;
  }
  .case-hero h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--fs-h1);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .case-lead {
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--ink-60);
    max-width: 60ch;
  }
  .live-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    padding: 12px 22px;
    border-radius: 100px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--fs-body);
    text-decoration: none;
    transition:
      background 0.18s,
      transform 0.18s;
  }
  .live-link:hover,
  .live-link:focus-visible {
    background: var(--coral);
    transform: translateY(-2px);
  }
</style>
