---
interface Item {
  src: string;
  alt: string;
}
interface Props {
  label: string;
  images: Item[];
}
const { label, images } = Astro.props;
---

<section class="case-gallery">
  <span class="gallery-label">{label}</span>
  <div class="gallery-grid" id="case-gallery-grid">
    {
      images.map((img, i) => (
        <button type="button" class="gallery-item" data-index={i} aria-label={img.alt}>
          <img src={img.src} alt={img.alt} loading="lazy" />
        </button>
      ))
    }
  </div>
</section>

<div class="gallery-lightbox" id="case-gallery-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
  <button type="button" class="gl-close" id="case-gallery-close" aria-label="Cerrar">✕</button>
  <button type="button" class="gl-nav gl-prev" id="case-gallery-prev" aria-label="Anterior">←</button>
  <img class="gl-img" id="case-gallery-img" src="" alt="" />
  <button type="button" class="gl-nav gl-next" id="case-gallery-next" aria-label="Siguiente">→</button>
</div>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-item'));
  const lightbox = document.getElementById('case-gallery-lightbox');
  const lbImg = document.getElementById('case-gallery-img') as HTMLImageElement | null;
  const btnClose = document.getElementById('case-gallery-close');
  const btnPrev = document.getElementById('case-gallery-prev');
  const btnNext = document.getElementById('case-gallery-next');

  if (items.length && lightbox && lbImg) {
    let current = 0;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const img = items[current].querySelector('img');
      if (!img) return;
      lbImg.src = img.src;
      lbImg.alt = img.alt;
    };

    const open = (i: number) => {
      show(i);
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    items.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
    btnClose?.addEventListener('click', close);
    btnPrev?.addEventListener('click', () => show(current - 1));
    btnNext?.addEventListener('click', () => show(current + 1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  }
</script>

<style>
  .case-gallery {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto clamp(50px, 7vh, 90px);
    padding: 0 clamp(24px, 5vw, 72px);
  }
  .gallery-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 18px;
  }
  .gallery-label::before {
    content: '\2726';
    font-size: 12px;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }
  .gallery-item {
    appearance: none;
    background: #fff;
    border: 1px solid var(--ink-12);
    border-radius: 16px;
    padding: 0;
    overflow: hidden;
    cursor: zoom-in;
    aspect-ratio: 4 / 5;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .gallery-item:hover,
  .gallery-item:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(20, 18, 16, 0.14);
    border-color: rgba(232, 93, 42, 0.35);
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(20, 18, 16, 0.92);
    padding: clamp(16px, 4vw, 48px);
  }
  .gallery-lightbox.open {
    display: flex;
  }
  .gl-img {
    max-width: min(90vw, 720px);
    max-height: 88vh;
    border-radius: 12px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }
  .gl-close,
  .gl-nav {
    appearance: none;
    background: rgba(250, 246, 240, 0.1);
    border: 1px solid rgba(250, 246, 240, 0.25);
    color: var(--paper);
    border-radius: 100px;
    cursor: pointer;
    transition: background 0.18s;
  }
  .gl-close:hover,
  .gl-nav:hover {
    background: rgba(250, 246, 240, 0.2);
  }
  .gl-close {
    position: absolute;
    top: clamp(14px, 3vw, 28px);
    right: clamp(14px, 3vw, 28px);
    width: 40px;
    height: 40px;
    font-size: 16px;
  }
  .gl-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    font-size: 18px;
  }
  .gl-prev {
    left: clamp(10px, 3vw, 28px);
  }
  .gl-next {
    right: clamp(10px, 3vw, 28px);
  }
  @media (max-width: 560px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gl-nav {
      width: 38px;
      height: 38px;
    }
  }
</style>
