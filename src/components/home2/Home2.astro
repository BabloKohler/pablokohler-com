---
import '@fontsource-variable/jetbrains-mono';
import '../../styles/home2.css';
import type { CollectionEntry } from 'astro:content';
import Hero2 from './Hero2.astro';
import Services2 from './Services2.astro';
import Close2 from './Close2.astro';
import Logos2 from './Logos2.astro';
import CasesMag from './CasesMag.astro';
import About from '../home/About.astro';
import { HOME } from '../../data/home';
import type { Lang, UiDictionary } from '../../i18n';

interface Props {
  lang: Lang;
  t: UiDictionary;
  cases: CollectionEntry<'cases-es' | 'cases-en'>[];
}
const { lang, t, cases } = Astro.props;
const c = HOME[lang];
---

<div class="home2">
  <Hero2 c={c} />
  <Services2 c={c} lang={lang} />
  <CasesMag cases={cases} lang={lang} heading={c.casesHeading} intro={c.casesIntro} viewCase={t.cases.viewCase} mag={c.mag} />
  <Logos2 lang={lang} label={t.trust.label} opens={c.mag.logosOpen} />
  <About t={c.about} />
</div>
<Close2 c={c} t={t.contact} lang={lang} />
