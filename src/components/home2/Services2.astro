---
import { MKT, mktHref } from '../../data/marketing';
import { mailto, type HomeCopy, type HomeLang } from '../../data/home';

interface Props {
  c: HomeCopy;
  lang: HomeLang;
  variant?: 'main' | 'au';
}
const { c, lang, variant = 'main' } = Astro.props;

// Las tres páginas de SEO, Google Ads y redes siguen existiendo: se enlazan desde la fila de conversión.
const also = MKT.map((m) => ({ label: m[lang].cardTitle, href: mktHref(lang, m[lang]) }));
const last = c.services.length - 1;
// **texto** del copy = palabras en coral dentro de la frase grande.
const noteHtml = c.servicesNote.replace(/\*\*(.+?)\*\*/g, '<span class="hot">$1</span>');
---

<section class="svc2" id="servicios">
  <div class="head reveal" data-reveal>
    <h2 class="sr-only">{c.servicesHeading.lead} {c.servicesHeading.accent}</h2>
    <p class="note" set:html={noteHtml} />
  </div>

  <ul class="rows">
    {
      c.services.map((s, i) => (
        <li class="row reveal" data-reveal style={`transition-delay:${i * 0.06}s`}>
          <h3><span class="t">{s.title}</span></h3>
          <p class="line">{s.line}</p>
          <div class="act">
            <a href={mailto(s.subject)} class="write" data-track="email_click" data-track-location="home_service" data-track-service={s.title}>
              {c.serviceLink} <span aria-hidden="true">→</span>
            </a>
            {i === last && variant === 'main' && (
              <p class="also">
                {c.alsoLabel}{' '}
                {also.map((a, k) => (
                  <>
                    {k > 0 && ' · '}
                    <a href={a.href}>{a.label}</a>
                  </>
                ))}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .svc2 {
    position: relative;
    z-index: 2;
    max-width: calc(1240px + 2 * var(--pad));
    margin: 0 auto;
    padding: clamp(72px, 11vh, 132px) var(--pad) clamp(48px, 7vh, 88px);
  }
  .head {
    margin-bottom: clamp(36px, 6vh, 64px);
  }
  h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--fs-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin-bottom: 20px;
    text-wrap: balance;
  }
  /* Frase grande con las palabras clave en coral (texto grande: contraste de 3:1 o más). */
  .note {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(26px, 3.1vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 24em;
    text-wrap: balance;
  }
  .note :global(.hot) {
    color: var(--coral);
  }

  .rows {
    list-style: none;
    border-bottom: 1px solid var(--ink-12);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) minmax(0, 3fr);
    gap: 12px clamp(24px, 4vw, 56px);
    align-items: start;
    padding: clamp(28px, 5vh, 48px) 0;
    border-top: 1px solid var(--ink-12);
  }
  /* Los nombres de servicio retoman la escala del titular de la portada. El marcador se dibuja al pasar o enfocar. */
  h3 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(28px, 3.2vw, 46px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .t {
    background-image: linear-gradient(var(--amber), var(--amber));
    background-repeat: no-repeat;
    background-position: 0 90%;
    background-size: 0% 0.38em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: background-size 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .row:hover .t,
  .row:focus-within .t {
    background-size: 100% 0.38em;
  }
  .line {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--ink-60);
    max-width: 38ch;
    padding-top: 0.3em;
  }
  .act {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    padding-top: 0.4em;
  }
  .write {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--fs-body);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-thickness 0.18s ease;
  }
  .write:hover,
  .row:hover .write {
    text-decoration-thickness: 4px;
  }
  .write span {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .row:hover .write span,
  .write:hover span {
    transform: translateX(4px);
  }
  .also {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-60);
  }
  .also a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--ink-12);
    text-underline-offset: 3px;
  }
  .also a:hover {
    text-decoration-color: var(--ink);
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .write span,
    .t {
      transition: none;
    }
  }
</style>
