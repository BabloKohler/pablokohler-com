---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import TrustMarquee from '../../components/home/TrustMarquee.astro';
import Capabilities from '../../components/home/Capabilities.astro';
import Formats from '../../components/home/Formats.astro';
import Cases from '../../components/home/Cases.astro';
import About from '../../components/home/About.astro';
import Contact from '../../components/home/Contact.astro';
import AuServices from '../../components/au/AuServices.astro';
import { AU_INDUSTRIES } from '../../data/au-industries';
import { AU_RESCUE } from '../../data/au-rescue';
import { AU_MARKETING } from '../../data/au-marketing';
import { MKT, mktHref } from '../../data/marketing';
import { AU_HOME_SEO } from '../../data/au-seo';
import { getDictionary } from '../../i18n';
import { IS_AU } from '../../site-target';

const t = getDictionary('en');

// En el build AU el caso más cercano al mercado (salón en Sydney) va primero.
const order = IS_AU
  ? ['shelovespink', 'bondipainters', 'heritagepainting', 'docomomo', 'one-health', 'uc-graficas']
  : ['saludamente', 'docomomo', 'one-health', 'uc-graficas', 'shelovespink', 'heritagepainting', 'bondipainters'];
const allCases = await getCollection('cases-en');
const cases = order
  .map((slug) => allCases.find((c) => c.id === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
---

<BaseLayout
  lang="en"
  title={IS_AU
    ? AU_HOME_SEO.title
    : 'Pablo Kohler: Digital Marketing & Communications Consultant'}
  description={IS_AU
    ? AU_HOME_SEO.description
    : 'Digital marketing and communications consultant. Websites, SEO and automation: strategy and build in one place, for clients in Latin America and Australia.'}
  navDict={t.nav}
  cookieDict={t.cookieConsent}
  esHref="/es/"
  enHref="/en/"
>
  <Hero t={t.hero} />
  <TrustMarquee t={t.trust} />
  <Capabilities t={t.caps} />
  {IS_AU && <AuServices />}
  {
    IS_AU && (
      <AuServices
        items={AU_MARKETING}
        id="au-marketing"
        headline="Get found and"
        accent="get customers"
        intro="SEO, Google Ads and Meta Ads for small businesses in Tasmania and across Australia, set up in accounts you own."
        location="home_marketing"
      />
    )
  }
  {
    !IS_AU && (
      <AuServices
        items={MKT.map((m) => m.en)}
        hrefOf={(s) => mktHref('en', s)}
        id="marketing"
        headline="Get found and"
        accent="get enquiries"
        intro="SEO, Google Ads and social media ads, set up in accounts you own, with a written quote after a free check."
        location="home_marketing"
      />
    )
  }
  {
    IS_AU && (
      <AuServices
        items={AU_RESCUE}
        id="au-rescue"
        headline="Already have a website"
        accent="you can’t manage?"
        intro="Built years ago, lost the logins, or just don’t know how to edit it? Start with a free check of who controls what."
        location="home_rescue"
      />
    )
  }
  {
    IS_AU && (
      <AuServices
        items={AU_INDUSTRIES}
        id="au-industries"
        headline="Websites built for"
        accent="your industry"
        intro="Different businesses need different things from a website. Here is what I focus on for Sydney businesses in these industries."
        location="home_industries"
      />
    )
  }
  <Formats t={t.formats} />
  <Cases t={t.cases} lang="en" cases={cases} />
  <About t={t.about} />
  <Contact t={t.contact} lang="en" />
</BaseLayout>
