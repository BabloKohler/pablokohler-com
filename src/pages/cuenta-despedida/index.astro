---
// Página temporal, no listada en nav ni en el sitemap (ver astro.config.mjs) ni indexable
// (meta robots noindex más abajo). Para repartir la cuenta de la despedida de Pablo en Chile
// entre los asistentes, en vivo. Se puede borrar esta carpeta completa cuando ya no sirva.
//
// El estado (quién está en la mesa, quién se asignó qué, la propina) vive en Firebase
// Realtime Database — no en este servidor, que es estático. Reemplaza `firebaseConfig` más
// abajo por la de tu propio proyecto (Firebase Console → ⚙️ Configuración del proyecto →
// General → Tus apps → objeto firebaseConfig). Ese objeto no es secreto, está pensado para
// ir en el código del navegador.
import Star from '../../components/Star.astro';
import '../../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Repartir la cuenta — Pablo Kohler</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--body);
        -webkit-text-size-adjust: 100%;
      }
      body {
        padding-bottom: calc(126px + env(safe-area-inset-bottom));
      }
      .wrap {
        max-width: 640px;
        margin: 0 auto;
        padding: 0 20px;
      }

      .top {
        position: relative;
        z-index: 21;
        padding: 18px 0;
        border-bottom: 1px solid var(--ink-12);
        background: var(--paper);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--display);
        font-weight: 700;
        font-size: 15px;
        color: var(--ink);
        text-decoration: none;
      }

      header.hero {
        padding: 26px 0 18px;
        border-bottom: 1px solid var(--ink-12);
      }
      .eyebrow {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--coral);
      }
      h1 {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(30px, 8vw, 44px);
        line-height: 1.02;
        letter-spacing: -0.03em;
        margin: 8px 0 10px;
      }
      .meta {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--ink-60);
        line-height: 1.7;
      }
      .meta b {
        color: var(--ink);
      }
      .live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--coral);
      }
      .live .pulse {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--coral);
      }
      .live.off {
        color: var(--magenta);
      }
      .live.off .pulse {
        background: var(--magenta);
      }

      h2 {
        font-family: var(--display);
        font-weight: 700;
        font-size: 18px;
        letter-spacing: -0.01em;
        margin: 28px 0 4px;
      }
      .hint {
        font-size: 13px;
        color: var(--ink-60);
        margin: 0 0 12px;
        line-height: 1.5;
      }

      button {
        font-family: var(--body);
        font-size: 15px;
        cursor: pointer;
        border-radius: 100px;
      }
      .btn {
        background: var(--ink);
        color: var(--paper);
        border: none;
        font-weight: 600;
        padding: 12px 18px;
      }
      .btn.ghost {
        background: transparent;
        color: var(--ink);
        border: 1px solid var(--ink-12);
      }
      .btn:disabled {
        opacity: 0.5;
        cursor: default;
      }
      input[type='text'] {
        width: 100%;
        background: #fff;
        border: 1px solid var(--ink-12);
        color: var(--ink);
        font-family: var(--body);
        font-size: 16px;
        padding: 13px 14px;
        border-radius: 12px;
      }
      input[type='text']:focus {
        outline: 2px solid var(--coral);
        outline-offset: 1px;
      }

      /* pantalla de identidad */
      .gate {
        position: fixed;
        inset: 0;
        background: var(--paper);
        z-index: 20;
        display: flex;
        align-items: center;
        overflow: auto;
      }
      .gate .wrap {
        width: 100%;
        padding: 32px 20px;
      }
      .claim {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 14px;
      }
      .claim button {
        background: transparent;
        border: 1px solid var(--ink-12);
        color: var(--ink-60);
        padding: 9px 13px;
      }

      .people {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 6px;
      }
      .person {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid var(--ink-12);
        border-radius: 100px;
        padding: 6px 8px 6px 13px;
        font-size: 14px;
      }
      .person.me {
        border-color: var(--coral);
        color: var(--coral);
      }
      .person .x {
        background: none;
        border: none;
        color: var(--ink-40);
        font-size: 16px;
        line-height: 1;
        padding: 2px 4px;
      }

      .item {
        border-bottom: 1px solid var(--ink-12);
      }
      .row {
        display: flex;
        align-items: baseline;
        gap: 10px;
        padding: 13px 2px;
        cursor: pointer;
      }
      .mark {
        width: 9px;
        height: 9px;
        flex: none;
        border-radius: 50%;
        background: var(--ink-12);
        margin-top: 5px;
      }
      .mark.done {
        background: var(--coral);
      }
      .mark.mine {
        box-shadow: 0 0 0 3px rgba(232, 93, 42, 0.25);
      }
      .nm {
        flex: 1;
        font-size: 15px;
        line-height: 1.35;
      }
      .qty {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-40);
      }
      .amt {
        font-family: var(--mono);
        font-size: 15px;
        white-space: nowrap;
      }
      .who {
        font-size: 12px;
        color: var(--ink-60);
        padding: 0 0 12px 19px;
        line-height: 1.5;
      }
      .who .m {
        color: var(--coral);
        font-weight: 600;
      }
      .panel {
        padding: 2px 0 16px 19px;
      }
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .chip {
        background: transparent;
        border: 1px solid var(--ink-12);
        color: var(--ink-60);
        padding: 7px 12px;
        font-size: 14px;
        border-radius: 100px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .chip.on {
        background: var(--ink);
        color: var(--paper);
        border-color: var(--ink);
        font-weight: 600;
      }
      .chip.self {
        border-color: var(--coral);
      }
      .step {
        background: rgba(255, 255, 255, 0.15);
        border: none;
        color: inherit;
        font-family: var(--mono);
        font-weight: 600;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        font-size: 14px;
        line-height: 1;
      }
      .u {
        font-family: var(--mono);
        font-size: 13px;
        min-width: 12px;
        text-align: center;
      }
      .quick {
        display: flex;
        gap: 16px;
        margin-top: 10px;
      }
      .quick button {
        background: none;
        border: none;
        color: var(--coral);
        font-size: 13px;
        font-weight: 600;
        padding: 2px 0;
      }

      .card {
        border: 1px solid var(--ink-12);
        border-left: 3px solid var(--ink-12);
        border-radius: 12px;
        padding: 13px 15px;
        margin-bottom: 8px;
        background: #fff;
      }
      .card.me {
        border-left-color: var(--coral);
      }
      .card .cardtop {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 10px;
      }
      .card .nom {
        font-family: var(--display);
        font-weight: 700;
        font-size: 17px;
        letter-spacing: -0.01em;
      }
      .card .tot {
        font-family: var(--mono);
        font-size: 17px;
      }
      .card .det {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-40);
        margin-top: 4px;
      }
      .empty {
        font-size: 14px;
        color: var(--ink-40);
        padding: 12px 0;
      }

      .bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(250, 246, 240, 0.94);
        border-top: 1px solid var(--ink-12);
        backdrop-filter: blur(8px);
        padding: 10px 0 calc(12px + env(safe-area-inset-bottom));
      }
      .bar .wrap {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .tiplab {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-40);
        width: 100%;
        margin-bottom: -4px;
      }
      .pend {
        flex: 1;
        min-width: 150px;
        font-family: var(--mono);
        font-size: 13px;
        line-height: 1.4;
      }
      .pend b {
        display: block;
        font-size: 17px;
        color: var(--magenta);
      }
      .pend b.ok {
        color: var(--coral);
      }
      .tip {
        display: flex;
        gap: 4px;
      }
      .tip button {
        background: transparent;
        border: 1px solid var(--ink-12);
        color: var(--ink-60);
        padding: 7px 10px;
        font-family: var(--mono);
        font-size: 13px;
        border-radius: 100px;
      }
      .tip button.on {
        background: var(--coral);
        border-color: var(--coral);
        color: var(--paper);
        font-weight: 600;
      }

      .toast {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        bottom: 106px;
        background: var(--ink);
        color: var(--paper);
        font-size: 14px;
        padding: 10px 16px;
        border-radius: 100px;
        z-index: 30;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s;
      }
      .toast.show {
        opacity: 1;
      }
      footer.note {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-40);
        padding: 24px 0 10px;
        line-height: 1.7;
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="top">
      <div class="wrap">
        <a href="/es/" class="brand">
          <Star size="16px" color="var(--coral)" />
          Pablo Kohler
        </a>
      </div>
    </div>

    <div class="gate" id="gate">
      <div class="wrap">
        <div class="eyebrow" id="gateCode">Mesa</div>
        <h1>¿Quién<br />eres?</h1>
        <p class="hint">Escribe tu nombre para entrar a la mesa. Todos ven lo mismo en tiempo real.</p>
        <input type="text" id="gateName" placeholder="Tu nombre" autocomplete="name" enterkeyhint="go" />
        <button class="btn" id="gateGo" style="margin-top:10px;width:100%">Entrar a la mesa</button>
        <div id="gateClaim"></div>
      </div>
    </div>

    <div class="wrap" id="app" hidden>
      <header class="hero">
        <div class="eyebrow">Boleta 29/08/2026 · 12:30 AM</div>
        <h1>Repartir<br />la cuenta</h1>
        <div class="meta">
          Mesa 203/1 · Total consumo <b>$456.690</b><br />
          <span id="youAre"></span> · <span class="live" id="live"><span class="pulse"></span>en vivo</span>
        </div>
        <button class="btn ghost" id="shareBtn" style="margin-top:12px">Copiar link para invitar</button>
      </header>

      <h2>En la mesa <span class="qty" id="count"></span></h2>
      <div class="people" id="people"></div>

      <h2>La cuenta</h2>
      <p class="hint">
        Toca un ítem y márcate. El monto se divide entre quienes se marcaron; en los ítems de varias unidades
        ajusta cuántas llevaste con − / +.
      </p>
      <div id="items"></div>

      <h2>Quién paga qué</h2>
      <div id="summary"></div>
      <button class="btn ghost" id="copyBtn" style="margin-top:6px">Copiar resumen</button>

      <footer class="note">
        Los montos se reparten en proporción a lo asignado y la propina se prorratea igual.<br />
        Esta mesa es temporal — la página se retira después de la despedida.
      </footer>
    </div>

    <div class="bar" id="bar" hidden>
      <div class="wrap">
        <div class="tiplab">Propina</div>
        <div class="pend" id="pend"></div>
        <div class="tip" id="tip"></div>
      </div>
    </div>

    <div class="toast" id="toast"></div>

    <script type="module">
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
      import {
        getDatabase,
        ref,
        onValue,
        runTransaction,
        set,
      } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js';

      // Reemplaza esto por la config de TU proyecto Firebase (Firebase Console → ⚙️ →
      // Configuración del proyecto → General → Tus apps). No es secreta, va en el navegador.
      const firebaseConfig = {
        apiKey: 'AIzaSyCUzi-eqNMDUf_SM5OykrCqJJGMMYLTi2o',
        authDomain: 'despedida-bablo.firebaseapp.com',
        databaseURL: 'https://despedida-bablo-default-rtdb.firebaseio.com',
        projectId: 'despedida-bablo',
        storageBucket: 'despedida-bablo.firebasestorage.app',
        messagingSenderId: '596026047411',
        appId: '1:596026047411:web:82bd8146661ec797c5e9c6',
      };

      const app = initializeApp(firebaseConfig);
      const db = getDatabase(app);

      /** Ítems de la boleta: [nombre, unidades, precio unitario, total]. */
      const ITEMS = [
        ['Quinceañera', 6, 8500, 51000],
        ['Jarra de Sangría', 6, 16000, 96000],
        ['London Mule', 1, 8000, 8000],
        ['Pollo BBQ Pizza', 1, 12590, 12590],
        ['Rica Rúccula Pizza', 1, 12590, 12590],
        ['Berry Berry Mojo', 2, 8500, 17000],
        ['Sangría', 1, 7000, 7000],
        ['Schop Mestra Stout Ale', 1, 5500, 5500],
        ['Chorrijuana', 1, 21990, 21990],
        ['Nor-Cal Nachos Original', 1, 9990, 9990],
        ['↳ Extra guacamole', 1, 2500, 2500],
        ['Gringa Rica Burger', 1, 10990, 10990],
        ['Quesadillas', 2, 8990, 17980],
        ['Hollywood Fries', 1, 6990, 6990],
        ['↳ Extra guacamole', 1, 2590, 2590],
        ['Schop LOA Flor de Truco', 2, 6200, 12400],
        ['Schop Stella Artois', 4, 5900, 23600],
        ['Extra Michelada Chilena', 2, 1500, 3000],
        ['Extra Michelada Mexicana', 1, 1500, 1500],
        ['Kunstmann Torobayo', 1, 6500, 6500],
        ['Schop LOA Entrenubes', 1, 5700, 5700],
        ['Moscow Mule', 1, 8000, 8000],
        ['Mistral 35 BB', 1, 7000, 7000],
        ['Schop LOA Ultra Ronda', 1, 5700, 5700],
        ['Schop Caliblonde', 3, 4500, 13500],
        ['Johnnie Walker Red BB', 8, 7000, 56000],
        ['Margarita Caprese', 1, 12590, 12590],
        ['Coca Cola 350 lata', 1, 3000, 3000],
        ['Nor-Cal Nachos Original', 1, 9990, 9990],
        ['↳ Extra veggie', 1, 2500, 2500],
        ['Coca Zero 350 lata', 1, 3000, 3000],
      ].map((it, id) => ({ id, name: it[0], qty: it[1], unit: it[2], total: it[3] }));

      const MAX_PEOPLE = 60;
      const TIPS = [0, 10, 12, 15];
      const COLORS = [
        '#e85d2a', '#f5a623', '#d4356b', '#c77dbb', '#4e9e86', '#8e8bd0', '#d9762b', '#c25a5a',
      ];

      const $ = (s) => document.querySelector(s);
      const clp = (n) => '$' + Math.round(n).toLocaleString('es-CL');

      // --- mesa: una sola por defecto; ?m=codigo permite reutilizar esta misma página para
      // otra ronda sin pisar el estado de esta ---
      const params = new URLSearchParams(location.search);
      const room = (params.get('m') || 'despedida-pablo').toLowerCase().replace(/[^a-z0-9-]/g, '') || 'despedida-pablo';
      const roomRef = ref(db, 'mesas/' + room);
      const KEY = 'cuenta:' + room;

      let state = null;
      let me = localStorage.getItem(KEY) || null;
      let open = null;

      function blankState() {
        return { tip: 10, people: {}, assign: {} };
      }
      function cleanName(n) {
        n = n.replace(/<[^>]*>/g, '').trim().replace(/\s+/g, ' ');
        return n.slice(0, 24);
      }

      // --- red (Firebase) ---
      onValue(roomRef, (snap) => {
        const v = snap.val();
        state = v && typeof v === 'object' ? { tip: 10, people: {}, assign: {}, ...v } : blankState();
        if (me && !state.people[me]) {
          me = null;
          localStorage.removeItem(KEY);
        }
        render();
      });
      onValue(ref(db, '.info/connected'), (snap) => setLive(!!snap.val()));

      function setLive(ok) {
        const el = $('#live');
        if (!el) return;
        el.className = 'live' + (ok ? '' : ' off');
        el.lastChild.textContent = ok ? 'en vivo' : 'sin conexión';
      }

      let toastT;
      function toast(msg) {
        const t = $('#toast');
        t.textContent = msg;
        t.className = 'toast show';
        clearTimeout(toastT);
        toastT = setTimeout(() => (t.className = 'toast'), 2200);
      }

      async function mutate(fn) {
        try {
          await runTransaction(roomRef, (s) => {
            s = s && typeof s === 'object' ? { tip: 10, people: {}, assign: {}, ...s } : blankState();
            return fn(s) || s;
          });
        } catch (e) {
          toast('No se pudo guardar, reintenta.');
        }
      }

      async function join(name) {
        name = cleanName(name);
        if (!name) {
          toast('Escribe tu nombre');
          return null;
        }
        const newId = crypto.randomUUID().slice(0, 8);
        let resultId = null;
        let full = false;
        await mutate((s) => {
          const existing = Object.entries(s.people).find(
            ([, p]) => p.name.toLowerCase() === name.toLowerCase(),
          );
          if (existing) {
            resultId = existing[0];
            return s;
          }
          if (Object.keys(s.people).length >= MAX_PEOPLE) {
            full = true;
            return s;
          }
          s.people[newId] = { name };
          resultId = newId;
          return s;
        });
        // El callback de arriba puede reintentarse solo internamente si hay contención — los
        // efectos secundarios (toast) van aquí afuera, donde se ejecutan una sola vez.
        if (full && !resultId) toast('Mesa llena.');
        return resultId;
      }

      function remove(pid) {
        return mutate((s) => {
          delete s.people[pid];
          for (const item of Object.keys(s.assign)) {
            delete s.assign[item][pid];
            if (!Object.keys(s.assign[item]).length) delete s.assign[item];
          }
          return s;
        });
      }

      function assign(item, pid, units) {
        const max = ITEMS[item].qty;
        units = Math.max(0, Math.min(max, units));
        return mutate((s) => {
          if (!s.people[pid]) return s;
          s.assign[item] = s.assign[item] || {};
          if (units === 0) delete s.assign[item][pid];
          else s.assign[item][pid] = units;
          if (!Object.keys(s.assign[item]).length) delete s.assign[item];
          return s;
        });
      }

      function clearItem(item) {
        return mutate((s) => {
          delete s.assign[item];
          return s;
        });
      }

      function everyone(item) {
        return mutate((s) => {
          s.assign[item] = s.assign[item] || {};
          for (const pid of Object.keys(s.people)) {
            if (!(pid in s.assign[item])) s.assign[item][pid] = 1;
          }
          return s;
        });
      }

      function setTip(v) {
        return set(ref(db, 'mesas/' + room + '/tip'), v);
      }

      // --- cálculo ---
      const unitsOf = (id) => state.assign[id] || {};
      const sumUnits = (id) => Object.values(unitsOf(id)).reduce((a, b) => a + b, 0);
      const peopleList = () => Object.entries(state.people).map(([id, p]) => ({ id, ...p }));
      function shareOf(item, pid) {
        const map = unitsOf(item.id);
        const sum = sumUnits(item.id);
        if (!sum || !map[pid]) return 0;
        return (item.total * map[pid]) / sum;
      }
      function totals() {
        const base = {};
        peopleList().forEach((p) => (base[p.id] = 0));
        let pend = 0;
        ITEMS.forEach((it) => {
          if (!sumUnits(it.id)) {
            pend += it.total;
            return;
          }
          peopleList().forEach((p) => (base[p.id] += shareOf(it, p.id)));
        });
        return { base, pend };
      }
      const colorOf = (pid) => {
        const i = peopleList().findIndex((p) => p.id === pid);
        return COLORS[Math.max(0, i) % COLORS.length];
      };

      // --- render ---
      function render() {
        if (!state) return;
        if (!me) {
          renderGate();
          return;
        }
        $('#gate').hidden = true;
        $('#app').hidden = false;
        $('#bar').hidden = false;

        const yo = state.people[me];
        $('#youAre').textContent = yo ? 'Eres ' + yo.name : '';
        const n = peopleList().length;
        $('#count').textContent = n + (n === 1 ? ' persona' : ' personas');

        renderPeople();
        renderItems();
        renderSummary();
        renderBar();
      }

      function renderGate() {
        $('#gate').hidden = false;
        $('#app').hidden = true;
        $('#bar').hidden = true;
        $('#gateCode').textContent = 'Mesa ' + room;
        const box = $('#gateClaim');
        const people = peopleList();
        if (people.length) {
          box.innerHTML = '<p class="hint" style="margin-top:22px">O si ya estás en la lista:</p>';
          const row = document.createElement('div');
          row.className = 'claim';
          people.forEach((p) => {
            const b = document.createElement('button');
            b.textContent = p.name;
            b.onclick = () => {
              me = p.id;
              localStorage.setItem(KEY, me);
              render();
            };
            row.appendChild(b);
          });
          box.appendChild(row);
        } else box.innerHTML = '';
      }

      function renderPeople() {
        const el = $('#people');
        el.innerHTML = '';
        peopleList().forEach((p) => {
          const d = document.createElement('div');
          d.className = 'person' + (p.id === me ? ' me' : '');
          const dot = document.createElement('span');
          dot.style.cssText = 'width:8px;height:8px;border-radius:50%;background:' + colorOf(p.id);
          const nm = document.createElement('span');
          nm.textContent = p.name;
          d.append(dot, nm);
          if (p.id === me) {
            const x = document.createElement('button');
            x.className = 'x';
            x.textContent = '×';
            x.title = 'Salir de la mesa';
            x.onclick = () => {
              if (confirm('¿Salir de la mesa? Se borra lo que te asignaste.')) {
                remove(me);
                localStorage.removeItem(KEY);
                me = null;
              }
            };
            d.appendChild(x);
          }
          el.appendChild(d);
        });
      }

      function renderItems() {
        const el = $('#items');
        el.innerHTML = '';
        ITEMS.forEach((it) => {
          const map = unitsOf(it.id);
          const ok = sumUnits(it.id) > 0;
          const mine = !!map[me];
          const box = document.createElement('div');
          box.className = 'item';

          const row = document.createElement('div');
          row.className = 'row';
          row.innerHTML =
            '<span class="mark ' +
            (ok ? 'done' : '') +
            (mine ? ' mine' : '') +
            '"></span><span class="nm"></span><span class="amt">' +
            clp(it.total) +
            '</span>';
          const nm = row.querySelector('.nm');
          nm.textContent = it.name;
          if (it.qty > 1) {
            const q = document.createElement('span');
            q.className = 'qty';
            q.textContent = '  ' + it.qty + ' × ' + clp(it.unit);
            nm.appendChild(q);
          }
          row.onclick = () => {
            open = open === it.id ? null : it.id;
            render();
          };
          box.appendChild(row);

          if (ok && open !== it.id) {
            const w = document.createElement('div');
            w.className = 'who';
            peopleList()
              .filter((p) => map[p.id])
              .forEach((p, i) => {
                const s = document.createElement('span');
                if (p.id === me) s.className = 'm';
                s.textContent =
                  (i ? '  ·  ' : '') + p.name + ' ' + clp(shareOf(it, p.id)) + (it.qty > 1 ? ' (' + map[p.id] + 'u)' : '');
                w.appendChild(s);
              });
            box.appendChild(w);
          }

          if (open === it.id) {
            const panel = document.createElement('div');
            panel.className = 'panel';
            const chips = document.createElement('div');
            chips.className = 'chips';
            peopleList().forEach((p) => {
              const on = !!map[p.id];
              const c = document.createElement('button');
              c.className = 'chip' + (on ? ' on' : '') + (p.id === me ? ' self' : '');
              const lab = document.createElement('span');
              lab.textContent = p.name;
              c.appendChild(lab);
              if (on && it.qty > 1) {
                const minus = document.createElement('button');
                minus.className = 'step';
                minus.textContent = '−';
                const u = document.createElement('span');
                u.className = 'u';
                u.textContent = map[p.id];
                const plus = document.createElement('button');
                plus.className = 'step';
                plus.textContent = '+';
                minus.onclick = (e) => {
                  e.stopPropagation();
                  assign(it.id, p.id, map[p.id] - 1);
                };
                plus.onclick = (e) => {
                  e.stopPropagation();
                  assign(it.id, p.id, map[p.id] + 1);
                };
                c.append(minus, u, plus);
              } else {
                c.onclick = () => assign(it.id, p.id, on ? 0 : 1);
              }
              chips.appendChild(c);
            });
            panel.appendChild(chips);

            const q = document.createElement('div');
            q.className = 'quick';
            const all = document.createElement('button');
            all.textContent = 'Fue de todos';
            all.onclick = () => everyone(it.id);
            const none = document.createElement('button');
            none.textContent = 'Limpiar';
            none.onclick = () => clearItem(it.id);
            q.append(all, none);
            panel.appendChild(q);
            box.appendChild(panel);
          }
          el.appendChild(box);
        });
      }

      function renderSummary() {
        const el = $('#summary');
        const { base } = totals();
        const tip = state.tip;
        const people = peopleList();
        if (!people.length) {
          el.innerHTML = '<div class="empty">Nadie en la mesa todavía.</div>';
          return;
        }
        el.innerHTML = '';
        people
          .slice()
          .sort((a, b) => base[b.id] - base[a.id])
          .forEach((p) => {
            const prop = (base[p.id] * tip) / 100;
            const c = document.createElement('div');
            c.className = 'card' + (p.id === me ? ' me' : '');
            if (p.id !== me) c.style.borderLeftColor = colorOf(p.id);
            c.innerHTML =
              '<div class="cardtop"><span class="nom"></span><span class="tot">' +
              clp(base[p.id] + prop) +
              '</span></div><div class="det">consumo ' +
              clp(base[p.id]) +
              (tip ? ' + propina ' + tip + '% ' + clp(prop) : '') +
              '</div>';
            c.querySelector('.nom').textContent = p.name;
            el.appendChild(c);
          });
      }

      function renderBar() {
        const { pend } = totals();
        $('#pend').innerHTML =
          pend > 0 ? '<b>' + clp(pend) + '</b> sin asignar' : '<b class="ok">Todo asignado</b>';
        const t = $('#tip');
        t.innerHTML = '';
        TIPS.forEach((v) => {
          const b = document.createElement('button');
          b.textContent = v ? v + '%' : 'Sin';
          if (v === state.tip) b.className = 'on';
          b.onclick = () => setTip(v);
          t.appendChild(b);
        });
      }

      // --- acciones globales ---
      $('#gateGo').onclick = async () => {
        const name = $('#gateName').value;
        const pid = await join(name);
        if (pid) {
          me = pid;
          localStorage.setItem(KEY, me);
          render();
        }
      };
      $('#gateName').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') $('#gateGo').click();
      });

      $('#shareBtn').onclick = async () => {
        const url = location.origin + location.pathname + (params.get('m') ? '?m=' + room : '');
        if (navigator.share) {
          try {
            await navigator.share({ title: 'Repartir la cuenta', url });
            return;
          } catch (e) {}
        }
        try {
          await navigator.clipboard.writeText(url);
          toast('Link copiado');
        } catch (e) {
          prompt('Copia el link:', url);
        }
      };

      $('#copyBtn').onclick = async () => {
        const { base, pend } = totals();
        const tip = state.tip;
        let txt = 'Cuenta Mesa 203 · 29/08 · $456.690' + (tip ? ' + ' + tip + '% propina' : '') + '\n\n';
        peopleList()
          .slice()
          .sort((a, b) => base[b.id] - base[a.id])
          .forEach((p) => (txt += p.name + ': ' + clp(base[p.id] * (1 + tip / 100)) + '\n'));
        if (pend > 0) txt += '\nFalta asignar: ' + clp(pend);
        try {
          await navigator.clipboard.writeText(txt);
          toast('Resumen copiado');
        } catch (e) {
          prompt('Copia el resumen:', txt);
        }
      };
    </script>
  </body>
</html>
