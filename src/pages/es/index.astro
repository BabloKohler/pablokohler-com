---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import TrustMarquee from '../../components/home/TrustMarquee.astro';
import Capabilities from '../../components/home/Capabilities.astro';
import Formats from '../../components/home/Formats.astro';
import Cases from '../../components/home/Cases.astro';
import About from '../../components/home/About.astro';
import Contact from '../../components/home/Contact.astro';
import AuServices from '../../components/au/AuServices.astro';
import { MKT, mktHref } from '../../data/marketing';
import { getDictionary } from '../../i18n';

const t = getDictionary('es');

// Orden editorial fijo (no el orden del filesystem) — así siempre sale primero el caso más cercano a Chile.
const order = ['saludamente', 'docomomo', 'one-health', 'uc-graficas', 'shelovespink', 'heritagepainting', 'bondipainters'];
const allCases = await getCollection('cases-es');
const cases = order
  .map((slug) => allCases.find((c) => c.id === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
---

<BaseLayout
  lang="es"
  title="Consultor de marketing digital en Chile | Pablo Kohler"
  description="Consultor de marketing digital y comunicaciones. Sitios web, SEO y automatización: estrategia y construcción en un solo lugar, en Chile y Latinoamérica."
  navDict={t.nav}
  cookieDict={t.cookieConsent}
  esHref="/es/"
  enHref="/en/"
>
  <Hero t={t.hero} />
  <TrustMarquee t={t.trust} />
  <Capabilities t={t.caps} />
  <AuServices
    items={MKT.map((m) => m.es)}
    hrefOf={(s) => mktHref('es', s)}
    id="marketing"
    headline="Que te encuentren y"
    accent="te consulten"
    intro="SEO, Google Ads y anuncios en redes, armados en cuentas que son tuyas, con una cotización por escrito después de una revisión gratis."
    location="home_marketing"
  />
  <Formats t={t.formats} />
  <Cases t={t.cases} lang="es" cases={cases} />
  <About t={t.about} />
  <Contact t={t.contact} lang="es" />
</BaseLayout>
